---
/** One post page. Alternates are limited to the locales the post exists in. */
import { render, type CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import Panel from './Panel.astro';
import TextNav from './TextNav.astro';
import SiteFooter from './SiteFooter.astro';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  slug: string;
  post: CollectionEntry<'posts'>;
  availableLangs: Lang[];
}
const { lang, slug, post, availableLangs } = Astro.props;
const { Content } = await render(post);
const fmt = new Intl.DateTimeFormat(lang === 'pt' ? 'pt-BR' : 'en-GB', { dateStyle: 'long', timeZone: 'UTC' });
---

<Base
  title={`${post.data.title} — Thiego "Zeru" Carvalho`}
  description={post.data.description}
  lang={lang}
  path={`/blog/${slug}/`}
  availableLangs={availableLangs}
>
  <TextNav lang={lang} current="blog" />
  <main>
    <Panel heading="h1" title={post.data.title} id="post">
      <time datetime={post.data.pubDate.toISOString()}>{fmt.format(post.data.pubDate)}</time>
      <div class="prose"><Content /></div>
    </Panel>
  </main>
  <SiteFooter lang={lang} />
</Base>

<style>
  time { display: block; margin-bottom: 16px; font-family: var(--font-pixel); text-transform: uppercase; font-size: 0.875rem; color: var(--color-ink-muted); }
  .prose :global(h2) { margin: 24px 0 6px; font-size: 1.5rem; font-weight: 700; }
  .prose :global(p) { margin: 0 0 10px; overflow-wrap: anywhere; }
  .prose :global(a) { color: var(--color-accent-cyan); }
</style>
