---
/**
 * Projects as a fan of 3.5" floppy disks. The markup is a plain horizontal
 * scroll-snap row with every project's details in the HTML, so it works with
 * no script at all (and swipes natively on touch). The script only reads the
 * scroll position to fan the disks and to move between them; the fan itself
 * is CSS 3D transforms driven by the custom property --o (signed distance from
 * the centre, in disks).
 */
import { getCollection } from 'astro:content';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const pad = (n: number) => String(n).padStart(2, '0');
const total = projects.length;
---

<div data-carousel data-of={t('projects.of')} role="region" aria-roledescription="carousel" aria-label={t('projects.region')}>
  <ol class="track" data-track tabindex="0" aria-label={t('projects.track')}>
    {projects.map(({ id, data: p }, i) => (
      <li class="slot" data-slot style={`--o:${i};--a:${i};z-index:${10 - i};--n:${i % 6}`}>
        <a
          class="disk"
          href={`#project-${id}`}
          data-disk
          aria-current={i === 0 ? 'true' : undefined}
          aria-label={`${p.name}, ${p.tag} (${i + 1} ${t('projects.of')} ${total})`}
        >
          <span class="floppy" aria-hidden="true">
            <span class="print">3.5″ HD</span>
            <span class="shutter"><span class="window"></span></span>
            <span class="label">
              <span class="name">{p.name}</span>
              <span class="tagline">{p.tag}</span>
            </span>
            <span class="notch"></span>
          </span>
        </a>
      </li>
    ))}
  </ol>

  <div class="controls" data-controls>
    <button type="button" data-prev aria-label={t('projects.prev')}>‹</button>
    <p class="status" data-status aria-live="polite">
      {`${projects[0].data.name} — 1 ${t('projects.of')} ${total}`}
    </p>
    <button type="button" data-next aria-label={t('projects.next')}>›</button>
  </div>

  <div class="details">
    {projects.map(({ id, data: p }, i) => (
      <article class="detail" id={`project-${id}`} data-project-entry data-active={i === 0 ? '' : undefined}>
        <p class="file">{`FILE ${pad(i + 1)}/${pad(total)}`}</p>
        <h3>{p.name}</h3>
        <p class="meta">
          <span data-project-tag>{p.tag}</span>
          <span>{t(`projects.kind.${p.kind}`)}</span>
        </p>
        <p class="summary">{p.summary[lang]}</p>
        <p class="tech">{p.tech.join(' · ')}</p>
        <p class="links">
          {p.url && <a href={p.url}>{t('projects.live')} ↗</a>}
          {p.repo && <a href={p.repo}>{t('projects.source')} ↗</a>}
        </p>
      </article>
    ))}
  </div>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-carousel]');
  if (root) {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const slots = [...root.querySelectorAll<HTMLElement>('[data-slot]')];
    const disks = slots.map((s) => s.querySelector<HTMLElement>('[data-disk]')!);
    const details = [...root.querySelectorAll<HTMLElement>('[data-project-entry]')];
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const names = details.map((d) => d.querySelector('h3')!.textContent ?? '');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const ofWord = root.dataset.of ?? '/';
    let current = 0;
    let goal = 0;
    let frame = 0;
    let settle = 0;

    const target = (i: number) => slots[i].offsetLeft + slots[i].offsetWidth / 2 - track.clientWidth / 2;

    const update = () => {
      frame = 0;
      const step = slots.length > 1 ? slots[1].offsetLeft - slots[0].offsetLeft : 1;
      const mid = track.scrollLeft + track.clientWidth / 2;
      let nearest = 0;
      let best = Infinity;
      slots.forEach((slot, i) => {
        const o = (slot.offsetLeft + slot.offsetWidth / 2 - mid) / step;
        const a = Math.abs(o);
        slot.style.setProperty('--o', Math.max(-2.5, Math.min(2.5, o)).toFixed(3));
        slot.style.setProperty('--a', Math.min(2.5, a).toFixed(3));
        slot.style.zIndex = String(10 - Math.round(a));
        if (a < best) {
          best = a;
          nearest = i;
        }
      });
      if (nearest !== current) {
        current = nearest;
        details.forEach((d, i) => d.toggleAttribute('data-active', i === current));
        disks.forEach((d, i) => (i === current ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
        status.textContent = `${names[current]} — ${current + 1} ${ofWord} ${slots.length}`;
      }
    };
    const schedule = () => {
      if (!frame) frame = requestAnimationFrame(update);
      clearTimeout(settle);
      settle = window.setTimeout(() => (goal = current), 150);
    };
    const go = (i: number) => {
      const next = Math.max(0, Math.min(slots.length - 1, i));
      goal = next;
      track.scrollTo({ left: target(next), behavior: reduce.matches ? 'auto' : 'smooth' });
    };

    track.addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', schedule);
    root.querySelector('[data-prev]')!.addEventListener('click', () => go(goal - 1));
    root.querySelector('[data-next]')!.addEventListener('click', () => go(goal + 1));
    disks.forEach((disk, i) =>
      disk.addEventListener('click', (e) => {
        e.preventDefault();
        go(i);
      }),
    );
    root.addEventListener('keydown', (e) => {
      if (e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
      const to = { ArrowLeft: goal - 1, ArrowRight: goal + 1, Home: 0, End: slots.length - 1 }[e.key];
      if (to === undefined) return;
      e.preventDefault();
      go(to);
    });

    track.scrollLeft = target(0);
    update();
  }
</script>

<style>
  [data-carousel] {
    --w: clamp(14rem, 58vw, 20rem);
    max-width: 72rem;
    margin: 0 auto;
  }

  .track {
    position: relative;
    display: flex;
    margin: 0;
    margin-inline: -16px;
    padding: 1.75rem calc(50% - var(--w) * 0.36) 2rem;
    list-style: none;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .track::-webkit-scrollbar { display: none; }
  .slot {
    flex: none;
    width: var(--w);
    margin-inline: calc(var(--w) * -0.14);
    scroll-snap-align: center;
  }

  .disk {
    display: block;
    border-radius: 4px;
    filter: drop-shadow(0 0 0.5px rgb(255 255 255 / 0.5)) drop-shadow(0 18px 18px rgb(0 0 0 / 0.65));
  }
  @media (scripting: enabled) {
    .disk {
      transform-origin: 50% 70%;
      transform: perspective(1000px) rotateY(calc(var(--o) * -32deg)) scale(calc(1 - var(--a) * 0.12));
      filter: brightness(calc(1 - var(--a) * 0.3)) drop-shadow(0 0 0.5px rgb(255 255 255 / 0.5))
        drop-shadow(0 18px 18px rgb(0 0 0 / 0.65));
      will-change: transform;
    }
  }

  /* The floppy. Everything is sized in cqw so it scales with the disk. */
  .floppy {
    --disk: #2f4a6b;
    --band: var(--color-accent-cyan);
    position: relative;
    display: block;
    aspect-ratio: 1;
    container-type: inline-size;
    background: linear-gradient(150deg, color-mix(in srgb, var(--disk), white 14%), var(--disk) 55%);
    clip-path: polygon(0 0, 88% 0, 100% 12%, 100% 100%, 0 100%);
  }
  .slot:nth-child(6n + 2) .floppy { --disk: #6b2f5e; --band: var(--color-accent-magenta); }
  .slot:nth-child(6n + 3) .floppy { --disk: #3f4350; --band: var(--color-hazard); }
  .slot:nth-child(6n + 4) .floppy { --disk: #1f6b73; --band: var(--color-accent-magenta); }
  .slot:nth-child(6n + 5) .floppy { --disk: #7a6a1c; --band: var(--color-accent-cyan); }
  .slot:nth-child(6n) .floppy { --disk: #3a6b3a; --band: var(--color-hazard); }

  .print {
    position: absolute;
    left: 5cqw;
    top: 5cqw;
    font-family: var(--font-pixel);
    font-size: 4.5cqw;
    letter-spacing: 0.06em;
    color: rgb(255 255 255 / 0.7);
  }
  .shutter {
    position: absolute;
    left: 24cqw;
    top: 0;
    width: 54cqw;
    height: 31cqw;
    background: linear-gradient(90deg, #8d929d, #e6e9ee 28%, #b4b9c3 62%, #8a8f9a);
    border-radius: 0 0 1.5cqw 1.5cqw;
    box-shadow: inset 0 -1cqw 0 rgb(0 0 0 / 0.18);
  }
  .window {
    position: absolute;
    right: 6cqw;
    top: 4cqw;
    width: 11cqw;
    height: 21cqw;
    background: #101217;
    border-radius: 1cqw;
    box-shadow: inset 0.8cqw 0.8cqw 0 rgb(0 0 0 / 0.6);
  }
  .label {
    position: absolute;
    left: 10cqw;
    right: 10cqw;
    top: 40cqw;
    bottom: 8cqw;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 9cqw 5cqw 4cqw;
    overflow: hidden;
    background:
      linear-gradient(var(--band) 0 0) top / 100% 5cqw no-repeat,
      repeating-linear-gradient(transparent 0 7.2cqw, rgb(40 70 120 / 0.28) 7.2cqw 7.6cqw),
      #f5efd9;
    border-radius: 0.8cqw;
    box-shadow: 0 0.6cqw 1.2cqw rgb(0 0 0 / 0.35);
  }
  .name {
    display: block;
    font-family: var(--font-body);
    font-size: 12cqw;
    font-weight: 700;
    font-style: italic;
    line-height: 1.04;
    letter-spacing: -0.02em;
    color: #1b2a78;
    text-wrap: balance;
    transform: rotate(-2.5deg);
    transform-origin: 0 100%;
  }
  .tagline {
    align-self: flex-start;
    font-family: var(--font-pixel);
    font-size: 5.2cqw;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #c4143f;
    text-decoration: underline wavy;
    text-decoration-thickness: 0.5cqw;
    text-underline-offset: 1cqw;
  }
  .notch {
    position: absolute;
    right: 4cqw;
    bottom: 3cqw;
    width: 5cqw;
    height: 5cqw;
    background: #08090c;
    box-shadow: inset 0 -2cqw 0 rgb(255 255 255 / 0.55);
  }

  .controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    padding: 0 16px;
  }
  @media (scripting: none) {
    .controls { display: none; }
  }
  .controls button {
    width: 48px;
    height: 48px;
    font-family: var(--font-body);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-ink);
    background: transparent;
    border: 1px solid var(--color-line-bright);
    cursor: pointer;
  }
  .controls button:hover { color: var(--color-void); background: var(--color-hazard); border-color: var(--color-hazard); }
  .status {
    min-width: 0;
    margin: 0;
    flex: 0 1 18rem;
    text-wrap: balance;
    font-family: var(--font-pixel);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
    color: var(--color-ink-muted);
  }

  .details {
    display: grid;
    max-width: 46rem;
    margin: 28px auto 0;
    padding: 0 16px;
    text-align: center;
  }
  .detail {
    grid-area: 1 / 1;
    visibility: hidden;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .detail[data-active] { visibility: visible; opacity: 1; }
  @media (scripting: none) {
    .details { display: block; text-align: left; }
    .detail { visibility: visible; opacity: 1; margin-bottom: 36px; padding-top: 16px; border-top: 1px solid var(--color-line); }
    .track { padding-inline: 16px; scroll-snap-type: x proximity; }
    .slot { margin-inline: 8px; }
  }
  .file {
    margin: 0 0 6px;
    font-family: var(--font-pixel);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--color-hazard);
  }
  h3 {
    margin: 0 0 10px;
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 700;
    font-style: italic;
    line-height: 1;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }
  .meta { display: flex; justify-content: center; gap: 8px; margin: 0 0 14px; }
  @media (scripting: none) { .meta { justify-content: flex-start; } }
  .meta span {
    padding: 2px 8px;
    font-family: var(--font-pixel);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: 1px solid var(--color-line-bright);
    color: var(--color-ink-muted);
  }
  .meta [data-project-tag] { color: var(--color-accent-magenta); border-color: var(--color-accent-magenta); }
  .summary { margin: 0 0 10px; line-height: 1.6; }
  .tech { margin: 0 0 14px; font-size: 0.8125rem; color: var(--color-ink-muted); }
  .links { display: flex; justify-content: center; gap: 12px; margin: 0; }
  @media (scripting: none) { .links { justify-content: flex-start; } }
  .links a {
    padding: 8px 14px;
    font-family: var(--font-pixel);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-hazard);
    text-decoration: none;
    border: 1px solid var(--color-hazard);
  }
  .links a:hover { color: var(--color-void); background: var(--color-hazard); }
</style>
