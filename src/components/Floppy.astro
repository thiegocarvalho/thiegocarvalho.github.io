---
/**
 * One 3.5" floppy disk for one project. Reusable: the carousel renders one per
 * project, and the per-project pages will link to and morph from the same
 * element. The disk carries a stable `view-transition-name` of `disk-<slug>`,
 * where the slug is the project's content id (its filename), so a
 * cross-document view transition can pair it with the drive on the other page.
 */
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Stable URL-safe slug, the project's content entry id. */
  slug: string;
  name: string;
  tag: string;
  index: number;
  total: number;
  /** Index of the disk the fan starts centred on. */
  start: number;
  /** Omit for the inert copy shown inside the drive on a project page. */
  href?: string;
}
const { lang, slug, name, tag, index, total, start, href } = Astro.props;
const t = useTranslations(lang);
const o = index - start;
const Outer = href ? 'li' : 'div';
const Inner = href ? 'a' : 'div';
---

<Outer
  class:list={['slot', { standalone: !href }]}
  data-slot
  data-slug={slug}
  data-variant={index % 6}
  style={`--o:${o};--a:${Math.abs(o)};z-index:${10 - Math.abs(o)}`}
>
  <Inner
    class="disk"
    href={href}
    data-disk
    style={`view-transition-name:disk-${slug};view-transition-class:disk`}
    aria-current={href && index === start ? 'true' : undefined}
    aria-label={href ? `${name}, ${tag} (${index + 1} ${t('projects.of')} ${total})` : undefined}
  >
    <span class="tilt" aria-hidden="true">
    <span class="face back"></span>
    <span class="face edge e-r"></span>
    <span class="face edge e-l"></span>
    <span class="face edge e-t"></span>
    <span class="face edge e-b"></span>
    <span class="face edge e-c"></span>
    <span class="floppy">
      <span class="track-strip"></span>
      <span class="arrow"></span>
      <span class="print">HD</span>
      <span class="shutter"><span class="window"></span></span>
      <span class="recess"></span>
      <span class="label">
        <span class="name">{name}</span>
        <span class="tagline">{tag}</span>
      </span>
      <span class="hole l"></span>
      <span class="hole r"></span>
    </span>
    </span>
  </Inner>
</Outer>

<style>
  .slot {
    flex: none;
    width: var(--w);
    margin-inline: calc(var(--w) * -0.14);
    scroll-snap-align: center;
  }
  @media (scripting: none) {
    .slot { margin-inline: 8px; }
  }
  .slot.standalone { margin-inline: 0; }
  .slot { --disk: #34495f; --band: var(--color-accent-cyan); }

  .disk {
    display: block;
    filter: drop-shadow(0 0 0.5px rgb(255 255 255 / 0.5)) drop-shadow(0 18px 18px rgb(0 0 0 / 0.65));
  }
  /*
   * The fan. --o is the signed distance from the centre in disks (set by the
   * script as the row scrolls) and --fan runs 0 (a stack) to 1 (fanned); the
   * carousel animates --fan on scroll where that is supported and otherwise it
   * stays at 1, the finished fan.
   */
  @media (scripting: enabled) {
    .tilt {
      --f: var(--fan, 1);
      --k: calc(1 - var(--f));
      transform-origin: 50% 70%;
      transform: perspective(1000px)
        translate(calc(var(--k) * var(--o) * var(--w) * -0.72), calc(var(--k) * var(--a) * -14px))
        rotate(calc(var(--k) * var(--o) * 4deg))
        rotateY(calc(var(--o) * var(--f) * -32deg))
        scale(calc(1 - var(--a) * var(--f) * 0.12));
      will-change: transform;
    }
    .disk {
      filter: brightness(calc(1 - var(--a) * var(--fan, 1) * 0.3 - var(--a) * (1 - var(--fan, 1)) * 0.12))
        drop-shadow(0 0 0.5px rgb(255 255 255 / 0.5)) drop-shadow(0 18px 18px rgb(0 0 0 / 0.65));
    }
  }

  /*
   * Thickness (3.3 mm on a 90 mm body, 3.7%). The view-transition-name on
   * .disk flattens its children, so the 3D lives one level down in .tilt: the
   * front face, a back plate and four edge strips share one 3D space and the
   * fan's rotateY shows the side edge as dark plastic.
   */
  .tilt {
    --t: calc(var(--w) * 0.037);
    --edge: color-mix(in srgb, var(--disk), black 58%);
    position: relative;
    display: block;
    transform-style: preserve-3d;
  }
  .tilt > .floppy { transform: translateZ(calc(var(--t) / 2)); }
  .face { position: absolute; display: block; backface-visibility: hidden; }
  .back {
    inset: 0;
    transform: translateZ(calc(var(--t) / -2)) rotateY(180deg);
    backface-visibility: visible;
    background: var(--edge);
    clip-path: polygon(0 0, 95% 0, 100% 5%, 100% 100%, 0 100%);
  }
  .edge { background: linear-gradient(var(--edge), color-mix(in srgb, var(--edge), black 35%)); backface-visibility: visible; }
  .e-r, .e-l { top: 5%; bottom: 0; width: var(--t); transform: rotateY(90deg); }
  .e-l { top: 0; left: calc(var(--t) / -2); }
  .e-r { right: calc(var(--t) / -2); }
  .e-t, .e-b { left: 0; width: 95%; height: var(--t); transform: rotateX(90deg); }
  .e-t { top: calc(var(--t) / -2); }
  .e-b { width: 100%; bottom: calc(var(--t) / -2); }
  /* the one chamfered corner, top right: 5% x 5% of the body, so 0.0707 long */
  .e-c {
    left: 95%;
    top: calc(var(--t) / -2);
    width: calc(var(--w) * 0.0707);
    height: var(--t);
    transform-origin: 0 50%;
    transform: rotate(45deg) rotateX(90deg);
  }

  /*
   * The floppy face, drawn after a real 90 x 94 mm disk: matte, one flat
   * plane. Everything is sized in cqw so it scales with the disk. Corners are
   * square; the single chamfer is top right.
   */
  .floppy {
    position: relative;
    display: block;
    aspect-ratio: 1;
    container-type: inline-size;
    background: linear-gradient(180deg, color-mix(in srgb, var(--disk), white 4%), color-mix(in srgb, var(--disk), black 4%));
    clip-path: polygon(0 0, 95% 0, 100% 5%, 100% 100%, 0 100%);
  }
  [data-variant='1'] { --disk: #6b3d62; --band: var(--color-accent-magenta); }
  [data-variant='2'] { --disk: #42454f; --band: var(--color-hazard); }
  [data-variant='3'] { --disk: #2e6268; --band: var(--color-accent-magenta); }
  [data-variant='4'] { --disk: #6f6528; --band: var(--color-accent-cyan); }
  [data-variant='5'] { --disk: #44663f; --band: var(--color-hazard); }

  /* where the shutter slides, a shade darker */
  .track-strip {
    position: absolute;
    left: 5cqw;
    top: 0;
    width: 17cqw;
    height: 33cqw;
    background: color-mix(in srgb, var(--disk), black 14%);
    box-shadow: inset 0 0.4cqw 0.6cqw rgb(0 0 0 / 0.25);
  }
  /* insertion arrow, embossed */
  .arrow {
    position: absolute;
    left: 10cqw;
    top: 8cqw;
    width: 6cqw;
    height: 6cqw;
    background: color-mix(in srgb, var(--disk), white 16%);
    clip-path: polygon(50% 0, 100% 100%, 0 100%);
  }
  .print {
    position: absolute;
    left: 78cqw;
    top: 4.5cqw;
    padding: 0.6cqw 1.2cqw 0.2cqw;
    font-family: var(--font-pixel);
    font-size: 4.6cqw;
    line-height: 1;
    letter-spacing: 0.08em;
    color: color-mix(in srgb, var(--disk), white 38%);
    border: 0.5cqw solid currentColor;
    /* too small to read on the far disks of the fan */
    opacity: clamp(0, calc(1.6 - var(--a, 0)), 1);
  }
  .shutter {
    position: absolute;
    left: 22cqw;
    top: 0;
    width: 50cqw;
    height: 33cqw;
    background:
      repeating-linear-gradient(0deg, rgb(255 255 255 / 0.28) 0 0.25cqw, rgb(0 0 0 / 0.07) 0.25cqw 0.55cqw),
      #a7acb4;
    box-shadow: 0 0.5cqw 0.8cqw rgb(0 0 0 / 0.35);
  }
  .window {
    position: absolute;
    right: 5cqw;
    top: 4cqw;
    width: 12.5cqw;
    height: 22cqw;
    background: #101217;
    box-shadow: inset 0.8cqw 0.8cqw 0 rgb(0 0 0 / 0.6);
  }
  /* the shallow recess the label sits in */
  .recess {
    position: absolute;
    left: 6cqw;
    right: 6cqw;
    top: 38cqw;
    bottom: 10cqw;
    background: color-mix(in srgb, var(--disk), white 9%);
    box-shadow: inset 0.5cqw 0.5cqw 0 rgb(0 0 0 / 0.3);
  }
  .label {
    position: absolute;
    left: 8cqw;
    right: 8cqw;
    top: 40cqw;
    bottom: 12cqw;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 9cqw 5cqw 4cqw;
    overflow: hidden;
    background:
      linear-gradient(var(--band) 0 0) top / 100% 5cqw no-repeat,
      repeating-linear-gradient(transparent 0 7.2cqw, rgb(40 70 120 / 0.28) 7.2cqw 7.6cqw),
      #f5efd9;
  }
  .name {
    display: block;
    font-family: var(--font-body);
    font-size: 12cqw;
    font-weight: 700;
    font-style: italic;
    line-height: 1.04;
    letter-spacing: -0.02em;
    color: #1b2a78;
    text-wrap: balance;
    transform: rotate(-2.5deg);
    transform-origin: 0 100%;
  }
  .tagline {
    align-self: flex-start;
    font-family: var(--font-pixel);
    font-size: 5.2cqw;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #c4143f;
    text-decoration: underline wavy;
    text-decoration-thickness: 0.5cqw;
    text-underline-offset: 1cqw;
  }
  /* write-protect window and HD hole */
  .hole {
    position: absolute;
    bottom: 2.5cqw;
    width: 4.5cqw;
    height: 4.5cqw;
    background: #08090c;
  }
  .hole.l { left: 6cqw; }
  .hole.r { right: 6cqw; }
</style>
