---
/**
 * One 3.5" floppy disk for one project. Reusable: the carousel renders one per
 * project, and the per-project pages will link to and morph from the same
 * element. The disk carries a stable `view-transition-name` of `disk-<slug>`,
 * where the slug is the project's content id (its filename), so a
 * cross-document view transition can pair it with the drive on the other page.
 */
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Stable URL-safe slug, the project's content entry id. */
  slug: string;
  name: string;
  tag: string;
  index: number;
  total: number;
  /** Index of the disk the fan starts centred on. */
  start: number;
  /** Omit for the inert copy shown inside the drive on a project page. */
  href?: string;
}
const { lang, slug, name, tag, index, total, start, href } = Astro.props;
const t = useTranslations(lang);
const o = index - start;
const Outer = href ? 'li' : 'div';
const Inner = href ? 'a' : 'div';
---

<Outer
  class:list={['slot', { standalone: !href }]}
  data-slot
  data-slug={slug}
  data-variant={index % 6}
  style={`--o:${o};--a:${Math.abs(o)};z-index:${10 - Math.abs(o)}`}
>
  <Inner
    class="disk"
    href={href}
    data-disk
    style={`view-transition-name:disk-${slug};view-transition-class:disk`}
    aria-current={href && index === start ? 'true' : undefined}
    aria-label={href ? `${name}, ${tag} (${index + 1} ${t('projects.of')} ${total})` : undefined}
  >
    <span class="tilt" aria-hidden="true">
    <span class="face back"></span>
    <span class="face edge e-r"></span>
    <span class="face edge e-l"></span>
    <span class="face edge e-t"></span>
    <span class="face edge e-b"></span>
    <span class="face edge e-c"></span>
    <span class="floppy">
      <span class="print">3.5″<br />HD</span>
      <span class="shutter"><span class="window"></span></span>
      <span class="label">
        <span class="name">{name}</span>
        <span class="tagline">{tag}</span>
      </span>
      <span class="notch"></span>
    </span>
    </span>
  </Inner>
</Outer>

<style>
  .slot {
    flex: none;
    width: var(--w);
    margin-inline: calc(var(--w) * -0.14);
    scroll-snap-align: center;
  }
  @media (scripting: none) {
    .slot { margin-inline: 8px; }
  }
  .slot.standalone { margin-inline: 0; }
  .slot { --disk: #2f4a6b; --band: var(--color-accent-cyan); }

  .disk {
    display: block;
    filter: drop-shadow(0 0 0.5px rgb(255 255 255 / 0.5)) drop-shadow(0 18px 18px rgb(0 0 0 / 0.65));
  }
  /*
   * The fan. --o is the signed distance from the centre in disks (set by the
   * script as the row scrolls) and --fan runs 0 (a stack) to 1 (fanned); the
   * carousel animates --fan on scroll where that is supported and otherwise it
   * stays at 1, the finished fan.
   */
  @media (scripting: enabled) {
    .tilt {
      --f: var(--fan, 1);
      --k: calc(1 - var(--f));
      transform-origin: 50% 70%;
      transform: perspective(1000px)
        translate(calc(var(--k) * var(--o) * var(--w) * -0.72), calc(var(--k) * var(--a) * -14px))
        rotate(calc(var(--k) * var(--o) * 4deg))
        rotateY(calc(var(--o) * var(--f) * -32deg))
        scale(calc(1 - var(--a) * var(--f) * 0.12));
      will-change: transform;
    }
    .disk {
      filter: brightness(calc(1 - var(--a) * var(--fan, 1) * 0.3 - var(--a) * (1 - var(--fan, 1)) * 0.12))
        drop-shadow(0 0 0.5px rgb(255 255 255 / 0.5)) drop-shadow(0 18px 18px rgb(0 0 0 / 0.65));
    }
  }

  /*
   * Thickness (3.3 mm on a 90 mm body, 3.7%). The view-transition-name on
   * .disk flattens its children, so the 3D lives one level down in .tilt: the
   * front face, a back plate and four edge strips share one 3D space and the
   * fan's rotateY shows the side edge as dark plastic.
   */
  .tilt {
    --t: calc(var(--w) * 0.037);
    --edge: color-mix(in srgb, var(--disk), black 58%);
    position: relative;
    display: block;
    transform-style: preserve-3d;
  }
  .tilt > .floppy { transform: translateZ(calc(var(--t) / 2)); }
  .face { position: absolute; display: block; backface-visibility: hidden; }
  .back {
    inset: 0;
    transform: translateZ(calc(var(--t) / -2)) rotateY(180deg);
    backface-visibility: visible;
    background: var(--edge);
    clip-path: polygon(0 0, 88% 0, 100% 12%, 100% 100%, 0 100%);
  }
  .edge { background: linear-gradient(var(--edge), color-mix(in srgb, var(--edge), black 35%)); backface-visibility: visible; }
  .e-r, .e-l { top: 12%; bottom: 0; width: var(--t); transform: rotateY(90deg); }
  .e-l { top: 0; left: calc(var(--t) / -2); }
  .e-r { right: calc(var(--t) / -2); }
  .e-t, .e-b { left: 0; width: 88%; height: var(--t); transform: rotateX(90deg); }
  .e-t { top: calc(var(--t) / -2); }
  .e-b { width: 100%; bottom: calc(var(--t) / -2); }
  /* the one chamfered corner, top right: 12% x 12% of the body, so 0.1697 long */
  .e-c {
    left: 88%;
    top: calc(var(--t) / -2);
    width: calc(var(--w) * 0.1697);
    height: var(--t);
    transform-origin: 0 50%;
    transform: rotate(45deg) rotateX(90deg);
  }

  /* The floppy. Everything is sized in cqw so it scales with the disk. */
  .floppy {
    position: relative;
    display: block;
    aspect-ratio: 1;
    container-type: inline-size;
    background:
      linear-gradient(118deg, rgb(255 255 255 / 0.2), rgb(255 255 255 / 0.04) 32%, transparent 33%, rgb(0 0 0 / 0.14)),
      linear-gradient(150deg, color-mix(in srgb, var(--disk), white 14%), var(--disk) 55%);
    box-shadow: inset 0 0 0 0.7cqw rgb(0 0 0 / 0.28), inset 0.9cqw 0.9cqw 0 rgb(255 255 255 / 0.1);
    clip-path: polygon(0 0, 88% 0, 100% 12%, 100% 100%, 0 100%);
  }
  [data-variant='1'] { --disk: #6b2f5e; --band: var(--color-accent-magenta); }
  [data-variant='2'] { --disk: #3f4350; --band: var(--color-hazard); }
  [data-variant='3'] { --disk: #1f6b73; --band: var(--color-accent-magenta); }
  [data-variant='4'] { --disk: #7a6a1c; --band: var(--color-accent-cyan); }
  [data-variant='5'] { --disk: #3a6b3a; --band: var(--color-hazard); }

  .print {
    position: absolute;
    left: 4cqw;
    top: 5cqw;
    /* Stacked in the strip left of the shutter (4-24cqw) so it is never covered. */
    width: 18cqw;
    line-height: 1.35;
    font-family: var(--font-pixel);
    font-size: 4.2cqw;
    letter-spacing: 0.06em;
    color: rgb(255 255 255 / 0.7);
  }
  .shutter {
    position: absolute;
    left: 24cqw;
    top: 0;
    width: 54cqw;
    height: 31cqw;
    background:
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.1) 0 0.3cqw, transparent 0.3cqw 0.8cqw),
      linear-gradient(90deg, #8d929d, #e6e9ee 28%, #b4b9c3 62%, #8a8f9a);
    box-shadow: inset 0 -1cqw 0 rgb(0 0 0 / 0.18), 0 1.2cqw 1.6cqw rgb(0 0 0 / 0.5), 0 0 0 0.3cqw rgb(0 0 0 / 0.25);
  }
  .window {
    position: absolute;
    right: 6cqw;
    top: 4cqw;
    width: 11cqw;
    height: 21cqw;
    background: #101217;
    box-shadow: inset 0.8cqw 0.8cqw 0 rgb(0 0 0 / 0.6);
  }
  .label {
    position: absolute;
    left: 10cqw;
    right: 10cqw;
    top: 40cqw;
    bottom: 8cqw;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 9cqw 5cqw 4cqw;
    overflow: hidden;
    background:
      linear-gradient(var(--band) 0 0) top / 100% 5cqw no-repeat,
      repeating-linear-gradient(transparent 0 7.2cqw, rgb(40 70 120 / 0.28) 7.2cqw 7.6cqw),
      #f5efd9;
    box-shadow: 0 0.6cqw 1.2cqw rgb(0 0 0 / 0.35), inset 0 0 0 0.3cqw rgb(255 255 255 / 0.55), 0 0 0 0.4cqw rgb(0 0 0 / 0.3);
  }
  .name {
    display: block;
    font-family: var(--font-body);
    font-size: 12cqw;
    font-weight: 700;
    font-style: italic;
    line-height: 1.04;
    letter-spacing: -0.02em;
    color: #1b2a78;
    text-wrap: balance;
    transform: rotate(-2.5deg);
    transform-origin: 0 100%;
  }
  .tagline {
    align-self: flex-start;
    font-family: var(--font-pixel);
    font-size: 5.2cqw;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #c4143f;
    text-decoration: underline wavy;
    text-decoration-thickness: 0.5cqw;
    text-underline-offset: 1cqw;
  }
  .notch {
    position: absolute;
    right: 4cqw;
    bottom: 3cqw;
    width: 5cqw;
    height: 5cqw;
    background: #08090c;
    box-shadow: inset 0 -2cqw 0 rgb(255 255 255 / 0.55);
  }
</style>
