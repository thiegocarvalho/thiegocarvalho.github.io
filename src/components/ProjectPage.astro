---
/**
 * One project page, shared by both locale routes. The disk from the home
 * carousel (same Floppy, same view-transition-name) lands above a 3.5" drive,
 * slides into the slot, and a terminal window rises with the project text.
 * The text is plain server-rendered HTML; the sequencing is CSS animation only,
 * and with no CSS animation (or reduced motion) the disk is already inserted
 * and the terminal fully shown. Zero JS.
 */
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import TextNav from './TextNav.astro';
import Floppy from './Floppy.astro';
import SiteFooter from './SiteFooter.astro';
import { localizePath, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  slug: string;
}
const { lang, slug } = Astro.props;
const t = useTranslations(lang);
const entry = (await getEntry('projects', slug))!;
const p = entry.data;
const summary = p.summary[lang];
// Meta descriptions read best under ~160 characters; cut at a word boundary.
const description =
  summary.length <= 160 ? summary : `${summary.slice(0, 157).replace(/\s+\S*$/, '')}…`;
const home = localizePath('/', lang);
const back = `${home}#projects`;
const dos = `${slug.replace(/[^a-z0-9]/gi, '').slice(0, 8).toUpperCase()}.TXT`;
---

<Base title={`${p.name} — Thiego "Zeru" Carvalho`} description={description} lang={lang} path={`/projects/${slug}/`}>
  <TextNav lang={lang} />
  <main>
    <a class="eject-top" href={back}>&lt; {t('project.eject')}</a>

    <div class="stage" aria-hidden="true">
      <p class="cap">{t('project.drive')}</p>
      <div class="bay">
        <div class="feed">
          <div class="insert">
            <Floppy lang={lang} slug={slug} name={p.name} tag={p.tag} index={0} total={1} start={0} />
          </div>
        </div>
        <div class="drive">
          <span class="slot-bar"></span>
          <span class="led"></span>
          <span class="mark">3.5″ HD</span>
          <span class="btn"></span>
        </div>
      </div>
    </div>

    <article class="term" aria-labelledby="proj-title">
      <header class="bar">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="bar-title">{`A:\\${dos} — ${t('project.window')}`}</span>
      </header>
      <div class="body">
        <p class="ln cmd" style="--i:0"><span class="ps">C:\&gt;</span> MOUNT A:</p>
        <p class="ln cmd" style="--i:1"><span class="ps">A:\&gt;</span> TYPE {dos}</p>
        <h1 id="proj-title" class="ln" style="--i:2">{p.name}</h1>
        <p class="ln meta" style="--i:3">
          <span class="tag">{p.tag}</span>
          <span>{t(`projects.kind.${p.kind}`)}</span>
        </p>
        <p class="ln summary" style="--i:4">{summary}</p>
        <p class="ln tech" style="--i:5"><span class="k">{t('projects.tech')}:</span> {p.tech.join(' · ')}</p>
        <p class="ln links" style="--i:6">
          {p.url && <a href={p.url}>{t('projects.live')} ↗</a>}
          {p.repo && <a href={p.repo}>{t('projects.source')} ↗</a>}
          <a class="eject" href={back}>&lt; {t('project.eject')}</a>
        </p>
        <p class="ln prompt" style="--i:7" aria-hidden="true"><span class="ps">A:\&gt;</span> <span class="cursor"></span></p>
      </div>
    </article>
  </main>
  <SiteFooter lang={lang} />
</Base>

<style>
  main {
    --w: clamp(9rem, 38vw, 10.5rem);
    --t0: 0.55s; /* the disk has landed (view-transition flight) */
    max-width: 52rem;
    margin: 0 auto;
    padding: 12px 16px 56px;
  }
  .eject-top, .eject {
    font-family: var(--font-pixel);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    color: var(--color-hazard);
    text-decoration: none;
  }
  .eject-top { display: inline-block; padding: 10px 0; }
  .eject-top:hover, .eject:hover { color: var(--color-ink); }

  /* ---- the drive ---- */
  .stage { display: grid; justify-items: center; margin-bottom: 6px; }
  .cap {
    justify-self: start;
    margin: 0 0 4px;
    font-family: var(--font-pixel);
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--color-ink-muted);
  }
  .bay {
    position: relative;
    width: calc(var(--w) * 1.5);
    height: calc(var(--w) * 1.5);
    /* Once the disk is in, the room it flew through closes up. */
    margin-top: calc(var(--w) * -0.68);
  }
  /* The window the disk passes through: it is cut off at the slot line. */
  .feed {
    position: absolute;
    z-index: 2;
    top: 0;
    left: calc(var(--w) * -0.1);
    width: calc(var(--w) * 1.7);
    height: calc(var(--w) * 1.12);
    padding-inline: calc(var(--w) * 0.3);
    box-sizing: border-box;
    overflow: clip;
    pointer-events: none;
  }
  .insert {
    width: var(--w);
    /* Shutter end first: turned half a revolution, the metal shutter leads into
       the slot and the label end is what stays outside. */
    transform: translateY(calc(var(--w) * 0.84)) rotate(180deg);
  }
  /* The turn flips the disk's own shadow; put it back below. */
  .insert :global(.disk) {
    filter: drop-shadow(0 0 0.5px rgb(255 255 255 / 0.5)) drop-shadow(0 -18px 18px rgb(0 0 0 / 0.65));
  }
  .drive {
    position: absolute;
    left: 0;
    right: 0;
    top: var(--w);
    height: calc(var(--w) * 0.5);
    border-radius: 5px 5px 8px 8px;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.35), transparent 14%),
      linear-gradient(180deg, #d4cdb8, #b3ac96);
    box-shadow: inset 0 -3px 0 rgb(0 0 0 / 0.25), 0 14px 26px rgb(0 0 0 / 0.6), 0 0 0 1px #6f6a5a;
  }
  .slot-bar {
    position: absolute;
    z-index: 3;
    left: 7%;
    right: 7%;
    top: calc(var(--w) * 0.1);
    height: calc(var(--w) * 0.045);
    background: #08090b;
    border-radius: 2px;
    box-shadow: inset 0 2px 3px #000, 0 1px 0 rgb(255 255 255 / 0.5);
  }
  .led {
    position: absolute;
    left: 9%;
    bottom: calc(var(--w) * 0.09);
    width: calc(var(--w) * 0.1);
    height: calc(var(--w) * 0.04);
    border-radius: 1px;
    background: #39ff7a;
    box-shadow: 0 0 8px 1px #39ff7a, inset 0 0 0 1px rgb(0 0 0 / 0.25);
  }
  .mark {
    position: absolute;
    left: 50%;
    bottom: calc(var(--w) * 0.09);
    transform: translateX(-50%);
    font-family: var(--font-pixel);
    font-size: calc(var(--w) * 0.065);
    color: #5d5848;
    white-space: nowrap;
  }
  .btn {
    position: absolute;
    right: 8%;
    bottom: calc(var(--w) * 0.07);
    width: calc(var(--w) * 0.2);
    height: calc(var(--w) * 0.075);
    border-radius: 2px;
    background: linear-gradient(180deg, #c3bca6, #9c967f);
    box-shadow: 0 2px 0 #4e4a3c, inset 0 1px 0 rgb(255 255 255 / 0.4);
  }

  /* Drive sequence. Every animated end state is the plain style above. */
  @keyframes insert-disk { from { transform: translateY(0) rotate(180deg); } }
  @keyframes close-up { from { margin-top: 0; } }
  @keyframes drive-led {
    0%, 100% { opacity: 1; }
    20% { opacity: 0.15; }
    45% { opacity: 1; }
    65% { opacity: 0.2; }
    80% { opacity: 1; }
  }
  @keyframes rise {
    from { opacity: 0; transform: translateY(2.5rem); clip-path: inset(100% 0 0 0); }
    to { opacity: 1; transform: none; clip-path: inset(0); }
  }
  @keyframes print-line { from { opacity: 0; clip-path: inset(0 0 100% 0); } to { opacity: 1; clip-path: inset(0); } }
  @keyframes type-line { from { opacity: 1; clip-path: inset(0 100% 0 0); } to { opacity: 1; clip-path: inset(0); } }
  @keyframes blink { 50% { opacity: 0; } }

  @media (prefers-reduced-motion: no-preference) {
    .insert {
      animation-name: insert-disk;
      animation-duration: 0.45s;
      animation-delay: var(--t0);
      animation-timing-function: cubic-bezier(0.6, 0, 0.7, 1);
      animation-fill-mode: backwards;
    }
    .bay {
      animation-name: close-up;
      animation-duration: 0.3s;
      animation-delay: calc(var(--t0) + 0.45s);
      animation-timing-function: ease-out;
      animation-fill-mode: backwards;
    }
    .led {
      animation-name: drive-led;
      animation-duration: 0.9s;
      animation-delay: calc(var(--t0) + 0.35s);
      animation-timing-function: steps(1, end);
      animation-fill-mode: backwards;
    }
    .term {
      animation-name: rise;
      animation-duration: 0.3s;
      animation-delay: 1s;
      animation-timing-function: cubic-bezier(0.2, 0.8, 0.2, 1);
      animation-fill-mode: backwards;
    }
    .ln {
      animation-name: print-line;
      animation-duration: 0.22s;
      animation-delay: calc(1.1s + var(--i) * 0.08s);
      animation-timing-function: steps(8, end);
      animation-fill-mode: backwards;
    }
    .cmd {
      animation-name: type-line;
      animation-duration: 0.2s;
      animation-delay: calc(1.05s + var(--i) * 0.12s);
      animation-timing-function: steps(14, end);
    }
    .cursor { animation: blink 1s steps(1, end) infinite; }
  }

  /* ---- the terminal ---- */
  .term {
    --green: #5dffa4;
    position: relative;
    z-index: 4;
    margin-top: 8px;
    color: var(--green);
    background: #02090a;
    border: 1px solid var(--color-accent-cyan);
    border-radius: 4px;
    box-shadow: 0 0 0 1px #000, 0 0 28px rgb(25 227 255 / 0.22), 0 26px 50px rgb(0 0 0 / 0.7);
    font-family: ui-monospace, 'Cascadia Mono', 'DejaVu Sans Mono', 'Courier New', monospace;
    overflow: hidden;
  }
  /* scanlines over the whole window, never blocking a click */
  .term::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      repeating-linear-gradient(0deg, rgb(0 0 0 / 0.22) 0 1px, transparent 1px 3px),
      radial-gradient(ellipse at center, transparent 55%, rgb(0 0 0 / 0.45));
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 6px 10px;
    color: #02090a;
    background: var(--color-accent-cyan);
    font-family: var(--font-pixel);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
  }
  .dots { display: flex; gap: 4px; }
  .dots i { width: 8px; height: 8px; background: #02090a; }
  .bar-title { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .body { padding: 14px 16px 18px; font-size: 0.9375rem; line-height: 1.65; }
  .body p { margin: 0 0 10px; }
  .ps { color: var(--color-hazard); }
  .cmd { margin-bottom: 2px; font-size: 0.875rem; letter-spacing: 0.04em; }
  h1 {
    margin: 14px 0 8px;
    font-family: var(--font-pixel);
    font-size: clamp(1.5rem, 6vw, 2.25rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-accent-cyan);
    text-shadow: 0 0 10px rgb(25 227 255 / 0.5);
  }
  .meta { display: flex; flex-wrap: wrap; gap: 8px; }
  .meta span {
    padding: 0 8px;
    font-family: var(--font-pixel);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: 1px solid currentColor;
    color: var(--color-ink-muted);
  }
  .meta .tag { color: var(--color-accent-magenta); }
  .summary { color: #c9f9de; }
  .tech { font-size: 0.8125rem; color: var(--color-ink-muted); }
  .k { color: var(--color-hazard); }
  .links { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 12px; margin-top: 16px; }
  .links a {
    padding: 8px 14px;
    font-family: var(--font-pixel);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--green);
    text-decoration: none;
    border: 1px solid var(--green);
  }
  .links a:hover { color: #02090a; background: var(--green); }
  .links a.eject { margin-inline-start: auto; color: var(--color-hazard); border-color: var(--color-hazard); }
  .links a.eject:hover { color: #02090a; background: var(--color-hazard); }
  .prompt { margin: 6px 0 0; }
  .cursor { display: inline-block; width: 0.6em; height: 1.05em; vertical-align: text-bottom; background: var(--green); }

  @media (min-width: 48rem) {
    main { --w: 10.5rem; }
    .body { padding: 20px 28px 24px; font-size: 1rem; }
  }
</style>
