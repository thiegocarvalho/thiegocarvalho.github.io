---
/**
 * A Windows 3.11 window, recolored for Night City. Honest markup: a real
 * <section> labelled by a real heading. The close box is decorative; Stage A
 * ships no script, so it is aria-hidden and not a control.
 */
interface Props {
  title: string;
  id?: string;
  tone?: 'default' | 'accent';
}

const { title, id, tone = 'default' } = Astro.props;
const slug = title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'window';
const headingId = `${id ?? slug}-title`;
---

<section data-window data-tone={tone} id={id} aria-labelledby={headingId}>
  <header data-window-bar>
    <span data-window-close aria-hidden="true"></span>
    <h2 id={headingId} data-window-title>{title}</h2>
  </header>
  <div data-window-body><slot /></div>
</section>

<style is:global>
  /* Hard 1px steps only: no radius, no blur, no gradient on the bevel. */
  [data-window] {
    --bar: var(--color-bar-cyan);
    box-sizing: border-box;
    width: 100%;
    max-width: 48rem;
    min-width: 0;
    margin: 0 auto 16px;
    background: var(--color-surface);
    color: var(--color-ink);
    border: 1px solid var(--color-bevel-dark);
    border-radius: 0;
    box-shadow:
      inset 1px 1px 0 var(--color-bevel-light),
      inset -1px -1px 0 var(--color-bevel-dark),
      inset 2px 2px 0 var(--color-surface-raised),
      4px 4px 0 var(--color-void);
  }
  [data-window][data-tone='accent'] {
    --bar: var(--color-bar-magenta);
  }
  [data-window] [data-window-bar] {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 3px;
    padding: 2px 4px;
    min-width: 0;
    background: var(--bar);
    color: var(--color-ink);
    border-radius: 0;
  }
  [data-window] [data-window-close] {
    flex: none;
    box-sizing: border-box;
    width: 16px;
    height: 16px;
    background:
      linear-gradient(#000, #000) center / 8px 2px no-repeat,
      var(--color-surface);
    border: 1px solid #000;
    border-radius: 0;
    box-shadow:
      inset 1px 1px 0 var(--color-bevel-light),
      inset -1px -1px 0 var(--color-bevel-dark);
  }
  [data-window] [data-window-title] {
    margin: 0;
    min-width: 0;
    font-family: var(--font-pixel);
    font-size: 0.8125rem;
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
  [data-window] [data-window-body] {
    margin: 0 3px 3px;
    padding: 12px;
    min-width: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-bevel-dark);
    border-radius: 0;
    box-shadow:
      inset 1px 1px 0 var(--color-bevel-dark),
      inset -1px -1px 0 var(--color-bevel-light);
    line-height: 1.6;
  }
</style>
