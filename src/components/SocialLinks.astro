---
const links = [
  { label: 'GitHub', href: 'https://github.com/thiegocarvalho' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/thiegocarvalho/' },
  { label: 'X', href: 'https://x.com/unusual_zeru' },
  { label: 'Instagram', href: 'https://www.instagram.com/unusual_zeru/' },
];
---

<ul>
  {links.map((l) => <li><a href={l.href} rel="me noopener">{l.label}</a></li>)}
</ul>

<style>
  ul { display: flex; flex-wrap: wrap; gap: 8px 16px; list-style: none; margin: 0; padding: 0; }
  a { color: var(--color-accent-cyan); }
</style>
