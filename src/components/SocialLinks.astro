---
const links = [
  { label: 'GitHub', href: 'https://github.com/thiegocarvalho' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/thiegocarvalho/' },
  { label: 'X', href: 'https://x.com/unusual_zeru' },
  { label: 'Instagram', href: 'https://www.instagram.com/unusual_zeru/' },
];
---

<ul>
  {links.map((l) => <li><a href={l.href} rel="me noopener">{l.label}</a></li>)}
</ul>

<style>
  ul { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; margin: 0; padding: 0; }
  a {
    display: block;
    padding: 10px 16px;
    font-family: var(--font-pixel);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--color-ink);
    border: 1px solid var(--color-line-bright);
  }
  a:hover { color: var(--color-void); background: var(--color-accent-cyan); border-color: var(--color-accent-cyan); }
</style>
