---
/**
 * An old rotary desk telephone beside the contact call to action, drawn after
 * a reference photo as a flat-shaded SVG in three-quarter view: a plinth, a
 * tapered body lit from the top left, the rotary dial on its front slope and
 * the handset resting on two cradle forks. Decorative only, no script.
 */
// ten finger holes around the dial, leaving the gap at the finger stop
const holes = Array.from({ length: 10 }, (_, i) => {
  const t = ((-35 - i * 31) * Math.PI) / 180;
  return [(33 * Math.cos(t)).toFixed(1), (24 * Math.sin(t)).toFixed(1)];
});
---

<div class="phone" aria-hidden="true">
<svg viewBox="0 0 400 300">
<defs>
<radialGradient id="ph-sh"><stop offset="0" stop-color="#000" stop-opacity=".7"/><stop offset="1" stop-color="#000" stop-opacity="0"/></radialGradient>
<linearGradient id="ph-fr" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#e4dcc8"/><stop offset="1" stop-color="#c2baa4"/></linearGradient>
<linearGradient id="ph-rt" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#b3ab94"/><stop offset="1" stop-color="#8f8873"/></linearGradient>
<linearGradient id="ph-hs" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#efe9d7"/><stop offset="1" stop-color="#b7af99"/></linearGradient>
<radialGradient id="ph-cup" cx=".35" cy=".3"><stop offset="0" stop-color="#f3eddc"/><stop offset=".6" stop-color="#d3cbb6"/><stop offset="1" stop-color="#a69e88"/></radialGradient>
</defs>
<ellipse cx="205" cy="246" rx="175" ry="40" fill="url(#ph-sh)"/>
<g stroke-linejoin="round">
<path d="M52 226 250 262 250 252 52 216Z" fill="#bdb59f" stroke="#bdb59f" stroke-width="2"/>
<path d="M250 262 352 214 352 204 250 252Z" fill="#938c76" stroke="#938c76" stroke-width="2"/>
<path d="M52 216 250 252 352 204 160 178Z" fill="#ddd6c2"/>
<path d="M250 248 340 203 288 119 238 143Z" fill="url(#ph-rt)" stroke="#a39b85" stroke-width="7"/>
<path d="M64 214 250 248 238 143 134 125Z" fill="url(#ph-fr)" stroke="#d5cdb8" stroke-width="7"/>
<path d="M134 125 238 143 288 119 190 103Z" fill="#efe8d5" stroke="#e6dfcb" stroke-width="7"/>
</g>
<path d="M86 203 C108 168 124 146 138 136" stroke="#fff" stroke-opacity=".45" stroke-width="4" fill="none" stroke-linecap="round"/>
<g transform="translate(174 188) rotate(10)">
<ellipse rx="52" ry="38" fill="#c9b783"/>
<ellipse rx="48" ry="35" fill="#e9dbaa"/>
<g fill="#5f594b">{holes.map(([x, y]) => <ellipse cx={x} cy={y} rx="6.6" ry="5" />)}</g>
<ellipse rx="19" ry="14" fill="#f5f2e8" stroke="#b9b39f" stroke-width="1.5"/>
<path d="M30 20 44 31" stroke="#77715f" stroke-width="3.5" stroke-linecap="round"/>
</g>
<g transform="translate(0 -15)" stroke-linejoin="round">
<path d="M169 122 187 125 193 119 175 116Z" fill="#efe8d5"/><path d="M169 122 187 125 187 135 169 132Z" fill="#cfc7b2"/><path d="M187 125 193 119 193 129 187 135Z" fill="#9f9882"/>
<path d="M235 134 253 137 259 131 241 128Z" fill="#efe8d5"/><path d="M235 134 253 137 253 147 235 144Z" fill="#cfc7b2"/><path d="M253 137 259 131 259 141 253 147Z" fill="#9f9882"/>
</g>
<g transform="translate(0 -15)"><ellipse cx="120" cy="130" rx="21" ry="9" fill="#9b937d"/>
<ellipse cx="124" cy="114" rx="25" ry="21" fill="url(#ph-cup)"/>
<path d="M134 102 Q220 88 300 116 L302 132 Q222 106 140 118Z" fill="url(#ph-hs)" stroke="#d9d2bd" stroke-width="3" stroke-linejoin="round"/>
<path d="M150 103 Q215 93 280 110" stroke="#fff" stroke-opacity=".5" stroke-width="3" fill="none" stroke-linecap="round"/>
<ellipse cx="312" cy="136" rx="29" ry="31" fill="url(#ph-cup)"/>
<ellipse cx="323" cy="148" rx="17" ry="21" fill="#c5bda8" stroke="#a8a08a" stroke-width="2.5"/>
<ellipse cx="301" cy="120" rx="7" ry="5" fill="#fff" fill-opacity=".7"/></g>
</svg>
</div>

<style>
  .phone { width: 100%; max-width: min(28rem, 82vw); }
  .phone svg { display: block; width: 100%; height: auto; }
</style>
