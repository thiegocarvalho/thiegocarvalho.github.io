---
/**
 * An 80s brick cell phone standing beside the contact call to action, after
 * the classic DynaTAC, built from the shared 3D box kit (global.css). The
 * front is not flat: an off-white frame (the head with the earpiece, two side
 * rails and the bottom lip) stands proud, and the grey-blue key panel sits
 * recessed inside it, reached by a chin that curves in under the earpiece and
 * a flare that sweeps back out to the lip at the bottom. The antenna rises
 * from the top.
 *
 * A toy: pressing the keys "dials" them, the digits run across the display
 * with each key's touch tone, and after a pause it goes back to its idle text.
 * Hidden from assistive tech and out of the tab order; without script the
 * keys simply do nothing.
 */
const keys = ['1', '2', '3', '4', '5', '6', '7', '8', '9', '*', '0', '#'];
---

<div class="phone" aria-hidden="true">
  <div class="set">
    <span class="box ant"><i class="fr"></i><i class="sd"></i></span>
    <span class="box brick">
      <i class="tp"></i><i class="sd"></i>
      <i class="head"><b class="ear"></b></i>
      <i class="rail"></i><i class="rail r"></i><i class="well"></i>
      <i class="chin"></i>
      <i class="panel">
        <b class="lcd">ZERU//</b>
        <b class="pad">
          {keys.map((k) => <button type="button" tabindex="-1">{k}</button>)}
        </b>
      </i>
      <i class="flare"></i>
      <i class="lip"></i>
    </span>
  </div>
</div>

<script is:inline type="module" data-phone>
  // dial: digits run across the display with each key's touch tone (DTMF), idle text back after 3s
  const p = document.querySelector('.phone'), l = p.querySelector('.lcd'), idle = l.textContent;
  let n = '', t, a;
  p.addEventListener('click', (e) => {
    const k = e.target.closest('button');
    if (!k) return;
    const d = k.textContent, i = '123456789*0#'.indexOf(d);
    l.textContent = n = (n + d).slice(-8);
    clearTimeout(t);
    t = setTimeout(() => (l.textContent = idle, n = ''), 3000);
    try {
      a ??= new AudioContext();
      const g = a.createGain(), T = a.currentTime;
      g.gain.setValueAtTime(0.06, T);
      g.gain.exponentialRampToValueAtTime(0.001, T + 0.16);
      g.connect(a.destination);
      for (const f of [[697, 770, 852, 941][(i / 3) | 0], [1209, 1336, 1477][i % 3]]) {
        const o = a.createOscillator();
        o.frequency.value = f;
        o.connect(g);
        o.start(T);
        o.stop(T + 0.16);
      }
    } catch {}
  });
</script>

<style is:global>
  /* global but every rule starts at .phone: scoping attributes would cost ~500 bytes here */
  /*
   * Sizes in cqw of .phone. The body is 30 wide, 104 tall, 36 deep; the panel
   * sits 2.5 behind the frame. Front, top to bottom: head 0-22, chin 22-30
   * (leaning back 17.4deg over 8.38), panel 30-84, flare 84-94 (leaning out
   * 14deg over 10.31), lip 94-104. Rails are 3.5 wide.
   */
  .phone { container-type: inline-size; width: 100%; max-width: min(21rem, 60vw); filter: drop-shadow(0 20px 18px rgb(0 0 0 / 0.6)); }
  .phone .set {
    position: relative;
    width: 30cqw;
    height: 104cqw;
    margin: 46cqw 0 6cqw 26cqw;
    transform-style: preserve-3d;
    transform: perspective(1600px) rotateX(-10deg) rotateY(-30deg);
  }
  .phone .brick { inset: 0; --d: 36cqw; }
  /* the invisible 3D planes would catch the clicks meant for the recessed keys */
  .phone .set { pointer-events: none; }
  .phone .pad button { pointer-events: auto; }
  .phone .brick > .sd { background: linear-gradient(90deg, #d6cfbf, #a8a192); }
  .phone .brick > .tp { background: #f4efe3; border-radius: 6cqw 6cqw 0 0; }
  .phone .head, .phone .rail, .phone .lip { background: linear-gradient(90deg, #f1ebdd, #e2dccd); }
  .phone .head { left: 0; top: 0; width: 100%; height: 22cqw; border-radius: 6cqw 6cqw 0 0; container-type: inline-size; }
  .phone .rail { left: 0; top: 22cqw; width: 3.5cqw; height: 72cqw; }
  .phone .rail.r { left: auto; right: 0; }
  /* the inner wall of the left rail, seen looking into the recess */
  .phone .well { left: 3.5cqw; top: 22cqw; width: 2.5cqw; height: 72cqw; transform-origin: 0 50%; transform: rotateY(90deg); background: #bdb6a6; }
  .phone .chin, .phone .panel, .phone .flare { left: 3.5cqw; width: 23cqw; transform-origin: 50% 0; }
  .phone .chin { top: 22cqw; height: 8.38cqw; transform: rotateX(-17.4deg); background: linear-gradient(#8f98a1, #a3acb5); }
  .phone .panel { top: 30cqw; height: 54cqw; transform: translateZ(-2.5cqw); background: linear-gradient(90deg, #aab3bc, #9aa3ac); container-type: inline-size; }
  .phone .flare { top: 84cqw; height: 10.31cqw; transform: translateZ(-2.5cqw) rotateX(14deg); background: radial-gradient(#3a3d40 0 3cqw, #0000 3.4cqw) 50% 60% / 22% 18% no-repeat, linear-gradient(#a3acb5, #c3cad1); }
  .phone .lip { left: 0; top: 94cqw; width: 100%; height: 10cqw; border-radius: 0 0 2cqw 2cqw; }
  /* the antenna: a thin grey rod from the middle of the top */
  .phone .ant { left: 44%; top: -44cqw; width: 2.4cqw; height: 44cqw; --d: 2.4cqw; transform: translateZ(-16cqw); }
  .phone .ant i { background: #8b9096; }

  .phone b { display: block; position: absolute; }
  /* earpiece: a grey cup in the head with a grille of holes */
  .phone .ear {
    inset: 14% 12% 10%;
    border-radius: 12cqw 12cqw 4cqw 4cqw;
    padding: 18cqw 22cqw;
    background: radial-gradient(#3e4246 1.6cqw, #0000 2cqw) 50% / 9cqw 9cqw content-box, #a3acb5;
    box-shadow: inset 0 2cqw 3cqw rgb(0 0 0 / 0.35);
  }
  .phone .lcd {
    inset: 5% 8% auto;
    height: 11%;
    display: grid !important;
    place-items: center;
    background: #151a18;
    font: 12cqw/1 var(--font-pixel);
    color: #ff3b30;
    text-shadow: 0 0 2cqw #ff3b30;
  }
  .phone .pad { inset: 22% 9% 4% 6%; display: grid !important; grid: repeat(4, 1fr) / repeat(3, 1fr); gap: 5cqw 7cqw; }
  .phone .pad button {
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    border-radius: 3cqw;
    background: linear-gradient(#f4f5f6, #d3d6da);
    box-shadow: 0 1.4cqw 0 #6b7179;
    font: 700 11cqw/1 var(--font-body);
    color: #2a2d31;
  }
  /* pressed: the key darkens and loses its edge; moving it would make the click miss */
  .phone .pad button:active { background: #c2c6cb; box-shadow: none; }
</style>
