---
/**
 * An old rotary desk telephone beside the contact call to action. The body is
 * a truncated pyramid on a thin plinth: each visible wall is a trapezoid
 * standing on its bottom edge, pushed out from the centre and tilted inward
 * (front, right side, flat top). The rotary dial sits on the front slope; the
 * handset and its two cradle forks come from the shared 3D box kit
 * (global.css). Decorative only.
 *
 * Units are cqw of .phone. Body: 60 x 54 at the base, 34 x 22 on top (set 6
 * back), 18 tall, so the front wall leans 50.7deg over 28.4, the sides
 * 35.8deg over 22.2.
 */
---

<div class="phone" aria-hidden="true">
  <div class="set">
    <i class="w plinth"></i><i class="w plinth s"></i><i class="w ledge"></i>
    <span class="upper">
      <i class="w front"><b class="dial"></b></i>
      <i class="w side"></i>
      <i class="w top"></i>
      <span class="box fork"><i class="fr"></i><i class="tp"></i><i class="sd"></i></span>
      <span class="box fork r"><i class="fr"></i><i class="tp"></i><i class="sd"></i></span>
      <span class="box grip"><i class="fr"></i><i class="tp"></i><i class="sd"></i></span>
      <span class="box cup"><i class="fr"></i><i class="tp"></i><i class="sd"></i></span>
      <span class="box cup r"><i class="fr"></i><i class="tp"></i><i class="sd"></i></span>
    </span>
  </div>
</div>

<style>
  .phone { position: relative; container-type: inline-size; width: 100%; max-width: min(28rem, 82vw); aspect-ratio: 5 / 4; }
  /* a zero-size origin at the middle of the base; every wall is placed from it */
  .set, .upper { position: absolute; transform-style: preserve-3d; }
  .set { left: 50%; top: 74%; transform: perspective(1800px) rotateX(-22deg) rotateY(-34deg); }
  .upper { transform: translateY(-3cqw); }
  /* a wall: stands on its bottom edge at the origin, then is turned, pushed out and leaned */
  .w { position: absolute; display: block; transform-origin: 50% 100%; }
  .plinth { left: -31cqw; top: -3cqw; width: 62cqw; height: 3cqw; transform: translateZ(28cqw); background: #b5ad97; box-shadow: 0 14px 26px rgb(0 0 0 / 0.75); }
  /* the plinth's top: the thin ledge left around the body's foot */
  .ledge { left: -31cqw; top: -28cqw; width: 62cqw; height: 56cqw; transform-origin: 50% 50%; transform: translateY(-3cqw) rotateX(90deg); background: #d3cbb6; }
  .plinth.s { left: -28cqw; width: 56cqw; transform: rotateY(90deg) translateZ(31cqw); background: #8d8772; box-shadow: none; }
  .front {
    left: -30cqw;
    top: -28.4cqw;
    width: 60cqw;
    height: 28.4cqw;
    transform: translateZ(27cqw) rotateX(50.7deg);
    clip-path: polygon(21.7% 0, 78.3% 0, 100% 100%, 0 100%);
    background: linear-gradient(#e2dac6, #c4bca7);
  }
  .side {
    left: -27cqw;
    top: -22.2cqw;
    width: 54cqw;
    height: 22.2cqw;
    transform: rotateY(90deg) translateZ(30cqw) rotateX(35.8deg);
    clip-path: polygon(40.7% 0, 81.5% 0, 100% 100%, 0 100%);
    background: linear-gradient(90deg, #a8a28b, #847e69);
  }
  .top { left: -17cqw; top: -11cqw; width: 34cqw; height: 22cqw; transform-origin: 50% 50%; transform: translateY(-18cqw) translateZ(-6cqw) rotateX(90deg); background: #e9e3cf; }
  /* the rotary dial: a cream disc, a ring of finger holes, a clear centre and the finger stop */
  .dial {
    position: absolute;
    left: 31%;
    top: 22%;
    width: 38%;
    aspect-ratio: 1;
    border-radius: 50%;
    background:
      radial-gradient(circle, #f4f1e6 0 30%, #b9b39f 31% 33%, transparent 34% 64%, #e9d9a6 65%),
      repeating-conic-gradient(from 20deg, #6e6857 0 15deg, #e9d9a6 15deg 30deg);
    box-shadow: 0 0 0 0.6cqw #c7b787;
  }
  .dial::after { content: ''; position: absolute; right: 8%; bottom: 14%; width: 26%; height: 5%; background: #8f8a7a; transform: rotate(40deg); }
  /* the cradle forks the handset rests on, then the handset: a grip and two cups */
  .fork { left: -15cqw; top: -23cqw; width: 7cqw; height: 5cqw; --d: 10cqw; transform: translateZ(-1cqw); }
  .fork.r { left: 8cqw; }
  .grip { left: -33cqw; top: -27cqw; width: 66cqw; height: 4cqw; --d: 8cqw; transform: translateZ(-2cqw); }
  .cup { left: -38cqw; top: -29cqw; width: 13cqw; height: 12cqw; --d: 14cqw; transform: translateZ(1cqw); }
  .cup.r { left: 25cqw; }
  .cup > i { border-radius: 35%; }
</style>
