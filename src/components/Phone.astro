---
/**
 * An 80s brick cell phone standing beside the contact call to action, after
 * the Motorola DynaTAC 8000X, built from the shared 3D box kit (global.css).
 * Its side is the real profile, all straight cuts and square corners: the
 * head leans back a little, a chin cuts in under the earpiece, the key
 * section runs straight and sunk, a flare cuts back out and a short foot
 * closes it. The front is five planes on that profile, an off-white rim
 * around the grey-blue face: earpiece grille on the head, red LED display on
 * the chin, keys on the middle, mic slot on the flare. Antenna at the back.
 *
 * A toy: pressing the keys "dials" them, the digits run across the display
 * with each key's touch tone, and after a pause it goes back to its idle text.
 * Hidden from assistive tech and out of the tab order; without script the
 * keys simply do nothing.
 */
const keys = ['1', '2', '3', '4', '5', '6', '7', '8', '9', '*', '0', '#'];
---

<div class="phone" aria-hidden="true">
  <div class="set">
    <span class="box ant"><i class="fr"></i><i class="sd"></i></span>
    <span class="box brick">
      <i class="tp"></i><i class="sd"></i>
      <i class="head"><b class="ear"></b></i>
      <i class="chin"><b class="lcd">ZERU//</b></i>
      <i class="mid">
        <b class="pad">
          {keys.map((k) => <button type="button" tabindex="-1">{k}</button>)}
        </b>
      </i>
      <i class="flare"></i>
      <i class="foot"></i>
    </span>
  </div>
</div>

<script is:inline type="module" data-phone>
  // dial: digits run across the display with each key's touch tone (DTMF), idle text back after 3s
  const p = document.querySelector('.phone'), l = p.querySelector('.lcd'), idle = l.textContent;
  let n = '', t, a;
  p.addEventListener('click', (e) => {
    const k = e.target.closest('button');
    if (!k) return;
    const d = k.textContent, i = '123456789*0#'.indexOf(d);
    l.textContent = n = (n + d).slice(-8);
    clearTimeout(t);
    t = setTimeout(() => (l.textContent = idle, n = ''), 3000);
    try {
      a ??= new AudioContext();
      const g = a.createGain(), T = a.currentTime;
      g.gain.setValueAtTime(0.06, T);
      g.gain.exponentialRampToValueAtTime(0.001, T + 0.16);
      g.connect(a.destination);
      for (const f of [[697, 770, 852, 941][(i / 3) | 0], [1209, 1336, 1477][i % 3]]) {
        const o = a.createOscillator();
        o.frequency.value = f;
        o.connect(g);
        o.start(T);
        o.stop(T + 0.16);
      }
    } catch {}
  });
</script>

<style is:global>
  /*
   * Global, but every rule starts at .phone (scoping attributes would cost
   * ~500 bytes). Sizes in cqw of .phone; the body is 30 wide, 104 tall, 43
   * deep. The front profile, measured off a side view (z back from the head's
   * face, y down): head (0,0)-(3.5,23.2), chin to (7.8,37.1), middle straight
   * to (7.8,83.8), flare out to (0,95.2), foot to (0,104). Each front plane
   * hangs from its top edge, pushed back to its depth and leaned by
   * atan(dz/dy).
   */
  .phone { container-type: inline-size; width: 100%; max-width: min(21rem, 60vw); filter: drop-shadow(0 20px 18px rgb(0 0 0 / 0.6)); }
  .phone .set {
    position: relative;
    width: 30cqw;
    height: 104cqw;
    margin: 40cqw 0 6cqw 24cqw;
    transform-style: preserve-3d;
    transform: perspective(1600px) rotateX(-10deg) rotateY(-30deg);
    /* the invisible 3D planes would catch the clicks meant for the sunk keys */
    pointer-events: none;
  }
  .phone .pad button { pointer-events: auto; }
  .phone .brick { inset: 0; --d: 43cqw; }
  .phone .brick > .tp { background: #f3f0e8; }
  .phone .brick > .sd {
    background: linear-gradient(90deg, #d9d5ca, #b4afa3);
    clip-path: polygon(0 0, 8.1% 22.3%, 18.1% 35.7%, 18.1% 80.6%, 0 91.5%, 0 100%, 100% 100%, 100% 0);
  }
  /* front planes: an off-white rim either side of the grey-blue face */
  .phone .head, .phone .chin, .phone .mid, .phone .flare, .phone .foot {
    left: 0;
    width: 100%;
    box-sizing: border-box;
    transform-origin: 50% 0;
    border: 0 solid #ebe7dc;
    border-width: 0 2.6cqw;
    background: #a6afb8;
    container-type: inline-size;
  }
  .phone .head {
    top: 0;
    height: 23.46cqw;
    transform: rotateX(-8.58deg);
    border-top-width: 3cqw;
  }
  /* the earpiece grille: a small square cluster of holes */
  .phone .ear { inset: 22% 32% 34%; background: radial-gradient(#3e4246 32%, #0000 38%) 0 0 / 25% 25%; }
  .phone .chin { top: 23.2cqw; height: 14.55cqw; transform: translateZ(-3.5cqw) rotateX(-17.19deg); background: #959ea7; }
  .phone .mid { top: 37.1cqw; height: 46.7cqw; transform: translateZ(-7.8cqw); }
  .phone .flare { top: 83.8cqw; height: 13.81cqw; transform: translateZ(-7.8cqw) rotateX(34.38deg); background: linear-gradient(#3a3d40 0 0) 50% 55% / 22% 9% no-repeat, #b9c1c9; }
  .phone .foot { top: 95.2cqw; height: 8.8cqw; transform: none; background: #ebe7dc; }
  /* the antenna: a black rod on a squat base, near the back */
  .phone .ant { left: 38%; top: -40cqw; width: 2.2cqw; height: 40cqw; --d: 2.2cqw; transform: translateZ(-34cqw); }
  .phone .ant i { background: #1c1c1f; }

  .phone b { display: block; position: absolute; }
  .phone .lcd {
    inset: 22% 6%;
    display: grid;
    place-items: center;
    background: #151a18;
    font: 12cqw/1 var(--font-pixel);
    color: #ff3b30;
    text-shadow: 0 0 2cqw #ff3b30;
  }
  .phone .pad { inset: 5% 4%; display: grid; grid: repeat(4, 1fr) / repeat(3, 1fr); gap: 6cqw 7cqw; }
  .phone .pad button {
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: linear-gradient(#f4f5f6, #d3d6da);
    box-shadow: 0 1.4cqw 0 #6b7179;
    font: 700 11cqw/1 var(--font-body);
    color: #2a2d31;
  }
  /* pressed: the key darkens and loses its edge; moving it would make the click miss */
  .phone .pad button:active { background: #c2c6cb; box-shadow: none; }
</style>
