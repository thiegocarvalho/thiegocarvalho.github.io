---
import { getCollection } from 'astro:content';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const MONTHS = {
  en: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
  pt: ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'],
}[lang];
const fmt = (d: Date) => `${MONTHS[d.getUTCMonth()]} ${d.getUTCFullYear()}`;

// A missing `end` is the ongoing role; it is shown once, as the end of the range.
const range = (start: Date, end?: Date) =>
  `${fmt(start)} — ${end ? fmt(end) : t('experience.present')}`;

const entries = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
---

<ol>
  {entries.map(({ data: e }) => (
    <li data-experience-entry class="reveal">
      <div class="when">
        <p class="range">{range(e.start, e.end)}</p>
        <p class="where">{[
          e.employment && t(`employment.${e.employment}`),
          e.arrangement && t(`arrangement.${e.arrangement}`),
          e.location,
        ].filter(Boolean).join(' · ')}</p>
      </div>
      <div class="what">
        <h3>{e.role[lang]}</h3>
        <p class="company">{e.company}</p>
        <ul class="highlights">
          {e.highlights[lang].map((h) => <li>{h}</li>)}
        </ul>
        {e.skills.length > 0 && <p class="skills">{e.skills.join(' · ')}</p>}
      </div>
    </li>
  ))}
</ol>

<style>
  ol { list-style: none; margin: 0; padding: 0; }
  li[data-experience-entry] {
    display: grid;
    gap: 8px 32px;
    padding: 24px 0;
    border-top: 1px solid var(--color-line);
  }
  li[data-experience-entry]:first-child { border-top: 0; padding-top: 0; }
  @media (min-width: 48rem) {
    li[data-experience-entry] { grid-template-columns: 13rem minmax(0, 1fr); }
  }
  .when p { margin: 0; }
  .range { font-family: var(--font-pixel); font-size: 0.8125rem; letter-spacing: 0.04em; color: var(--color-hazard); }
  .where { margin-top: 4px; font-size: 0.8125rem; color: var(--color-ink-muted); }
  h3 { margin: 0; font-size: 1.25rem; font-weight: 700; line-height: 1.2; }
  .company { margin: 2px 0 12px; color: var(--color-accent-cyan); font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; font-size: 0.875rem; }
  .highlights { margin: 0; padding: 0; list-style: none; }
  .highlights li { position: relative; margin-bottom: 8px; padding-left: 1.25rem; }
  .highlights li::before { content: '▸'; position: absolute; left: 0; color: var(--color-accent-magenta); }
  .skills { margin: 10px 0 0; color: var(--color-ink-muted); font-family: var(--font-pixel); font-size: 0.6875rem; letter-spacing: 0.04em; }
</style>
