---
import { getCollection } from 'astro:content';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const MONTHS = {
  en: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
  pt: ['jan', 'fev', 'mar', 'abr', 'mai', 'jun', 'jul', 'ago', 'set', 'out', 'nov', 'dez'],
}[lang];
const fmt = (d: Date) => `${MONTHS[d.getUTCMonth()]} ${d.getUTCFullYear()}`;

// A missing `end` is the ongoing role; it is shown once, as the end of the range.
const range = (start: Date, end?: Date) =>
  `${fmt(start)} — ${end ? fmt(end) : t('experience.present')}`;

const entries = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
---

<ol>
  {entries.map(({ data: e }, i) => (
    <li data-experience-entry class="record">
      <div class="when">
        <p class="year">{e.start.getUTCFullYear()}</p>
        {!e.end && <p class="now">{t('experience.present')}</p>}
      </div>
      <div class="what">
        <p class="rec" aria-hidden="true">{`REC ${String(i + 1).padStart(2, '0')}/${String(entries.length).padStart(2, '0')}`}</p>
        <p class="range">{range(e.start, e.end)}</p>
        <h3>{e.role[lang]}</h3>
        <p class="company">{e.company}</p>
        <p class="where">{[
          e.employment && t(`employment.${e.employment}`),
          e.arrangement && t(`arrangement.${e.arrangement}`),
          e.location,
        ].filter(Boolean).join(' · ')}</p>
        <ul class="highlights">
          {e.highlights[lang].map((h) => <li>{h}</li>)}
        </ul>
        {e.skills.length > 0 && <p class="skills">{e.skills.join(' · ')}</p>}
      </div>
    </li>
  ))}
</ol>

<style>
  /*
   * A plain ordered list of two-column records. The year column is
   * `position: sticky` inside each record, so while a record is on screen its
   * start year stays pinned beside it and the next record pushes it out: the
   * year "changes" as you scroll, with the page scrolling exactly as normal.
   * Without sticky or scroll-driven animation support it is just a list.
   */
  ol { list-style: none; margin: 0; padding: 0; }
  li[data-experience-entry] {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    gap: 0 8px;
    padding: 0 0 36px;
  }
  .when { align-self: start; position: sticky; top: max(1rem, 28vh); padding-top: 2px; }
  .when p { margin: 0; }
  .year {
    font-family: var(--font-pixel);
    font-size: 1.25rem;
    line-height: 1;
    white-space: nowrap;
    overflow-wrap: normal;
    letter-spacing: -0.02em;
    color: var(--color-hazard);
  }
  .now {
    margin-top: 6px !important;
    display: inline-block;
    padding: 2px 4px;
    font-family: var(--font-pixel);
    font-size: 0.5625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-void);
    background: var(--color-accent-cyan);
  }
  .what { min-width: 0; padding: 2px 0 0 10px; border-left: 1px solid var(--color-line-bright); }
  @media (min-width: 48rem) {
    li[data-experience-entry] { grid-template-columns: 11rem minmax(0, 1fr); gap: 0 28px; padding-bottom: 56px; }
    .when { top: max(5.5rem, 28vh); }
    .year { font-size: clamp(2.5rem, 4.4vw, 3.75rem); }
    .now { font-size: 0.75rem; padding: 3px 8px; }
    .what { padding-left: 28px; }
  }
  .rec { margin: 0 0 6px; font-family: var(--font-pixel); font-size: 0.625rem; letter-spacing: 0.1em; color: var(--color-ink-muted); }
  .range { margin: 0; font-family: var(--font-pixel); font-size: 0.8125rem; letter-spacing: 0.04em; color: var(--color-hazard); }
  .where { margin: 0 0 12px; font-size: 0.8125rem; color: var(--color-ink-muted); }
  h3 { margin: 6px 0 0; font-size: 1.375rem; font-weight: 700; line-height: 1.2; }
  .company { margin: 2px 0 4px; color: var(--color-accent-cyan); font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; font-size: 0.875rem; }
  .highlights { margin: 0; padding: 0; list-style: none; }
  .highlights li { position: relative; margin-bottom: 8px; padding-left: 1.25rem; }
  .highlights li::before { content: '▸'; position: absolute; left: 0; color: var(--color-accent-magenta); }
  .skills { margin: 10px 0 0; color: var(--color-ink-muted); font-family: var(--font-pixel); font-size: 0.6875rem; letter-spacing: 0.04em; }

  /* Each record is "filed" as it scrolls in: it slides in from the side while
     a scan edge wipes it open, then it is simply there. Pixel-length range so a
     record taller than the screen still completes on its first 240px. */
  @keyframes file-in {
    from { opacity: 0; transform: translateX(-28px); clip-path: inset(0 100% 0 0); }
    to { opacity: 1; transform: none; clip-path: inset(0); }
  }
  @keyframes year-in {
    from { opacity: 0.25; transform: scale(0.85); transform-origin: 0 0; }
    to { opacity: 1; transform: none; }
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .what {
        animation-name: file-in;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 0px entry 260px;
      }
      .year {
        animation-name: year-in;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 0px entry 200px;
      }
    }
  }
</style>
