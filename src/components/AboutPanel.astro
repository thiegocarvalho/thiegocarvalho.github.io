---
import { getEntry, render } from 'astro:content';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const entry = await getEntry('about', Astro.props.lang);
if (!entry) throw new Error(`Missing about entry for "${Astro.props.lang}"`);
const { Content } = await render(entry);
---

<div class="prose"><Content /></div>

<style>
  .prose { max-width: 48rem; }
  .prose :global(p) { margin: 0 0 14px; }
  .prose :global(ul) { margin: 0 0 14px; padding: 0; list-style: none; }
  .prose :global(li) { position: relative; margin-bottom: 8px; padding-left: 1.25rem; }
  .prose :global(li)::before { content: '▸'; position: absolute; left: 0; color: var(--color-accent-magenta); }
  .prose :global(strong) { color: var(--color-accent-cyan); font-weight: 600; }
</style>
