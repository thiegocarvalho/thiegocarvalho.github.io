---
import { getEntry, render } from 'astro:content';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const entry = await getEntry('about', Astro.props.lang);
if (!entry) throw new Error(`Missing about entry for "${Astro.props.lang}"`);
const { Content } = await render(entry);
---

<div class="prose"><Content /></div>

<style>
  .prose :global(p) { margin: 0 0 12px; }
  .prose :global(ul) { margin: 0 0 12px; padding-left: 1.1rem; }
  .prose :global(li) { margin-bottom: 6px; }
  .prose :global(strong) { color: var(--color-accent-cyan); font-weight: 600; }
</style>
