---
/**
 * The always-present text navigation. Primary, not a fallback: it serves
 * keyboard, screen reader and crawler on every page, whatever else is
 * enhanced on top of it.
 */
import { localizePath } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  current?: string;
}
const { lang, current } = Astro.props;
const t = useTranslations(lang);
// Section links carry the home path, not a bare hash: on the home page the
// browser still just scrolls, but from /blog/ a bare "#career" would point at
// a section that is not on the page and silently do nothing.
const home = localizePath('/', lang);
const items = [
  { id: 'projects', href: `${home}#projects`, label: t('nav.projects') },
  { id: 'profile', href: localizePath('/about/', lang), label: t('nav.profile') },
  { id: 'blog', href: localizePath('/blog/', lang), label: t('nav.blog') },
  { id: 'contact', href: `${home}#contact`, label: t('nav.contact') },
];

/*
 * The language switch. Without it the site is bilingual only to crawlers:
 * hreflang tells Google the other version exists, but a visitor on / has no
 * way to reach /pt at all.
 *
 * It targets the counterpart of the current page when that page exists in
 * both locales, and otherwise the other locale's home. A post written in one
 * language only has no counterpart, so sending the visitor to a URL that was
 * never built would turn a missing translation into a 404.
 */
const other: Lang = lang === 'en' ? 'pt' : 'en';
const logical = Astro.url.pathname.replace(/^\/pt(?=\/|$)/, '') || '/';
const MIRRORED = ['/', '/blog/', '/about/'];
const mirrored = MIRRORED.includes(logical.endsWith('/') ? logical : `${logical}/`);
const switchHref = localizePath(mirrored ? logical : '/', other);
---

<nav data-text-nav aria-label={t('nav.label')}>
  <a class="brand" href={home} aria-label="Thiego Zeru Carvalho">ZERU<span aria-hidden="true">//</span></a>
  <ul>
    {items.map((i) => (
      <li><a href={i.href} aria-current={current === i.id ? 'page' : undefined}>{i.label}</a></li>
    ))}
    <li data-lang-switch>
      <a href={switchHref} hreflang={other === 'pt' ? 'pt-br' : 'en'} lang={other === 'pt' ? 'pt-br' : 'en'} aria-label={t(`lang.switch.${other}`)}>
        <span class="long">{t(`lang.switch.${other}`)}</span>
        <span class="short" aria-hidden="true">{other.toUpperCase()}</span>
      </a>
    </li>
  </ul>
</nav>

<style>
  nav {
    display: flex;
    align-items: center;
    gap: 4px 20px;
    padding: 6px 16px;
    background: rgb(5 5 7 / 0.92);
    border-bottom: 1px solid var(--color-line);
    z-index: 20;
  }
  @media (min-width: 48rem) {
    nav { position: sticky; top: 0; padding-block: 10px; padding-inline: max(16px, calc((100% - 72rem) / 2 + 16px)); }
  }
  .brand {
    font-family: var(--font-body);
    font-weight: 700;
    font-style: italic;
    font-size: 1.125rem;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    text-decoration: none;
  }
  .brand span { color: var(--color-hazard); }
  ul { display: flex; flex: 1; min-width: 0; gap: 0 4px; list-style: none; margin: 0; padding: 0; }
  li a {
    display: block;
    padding: 8px 8px;
    font-family: var(--font-pixel);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink-muted);
    text-decoration: none;
    border-bottom: 2px solid transparent;
  }
  li a:hover { color: var(--color-accent-cyan); }
  li a[aria-current] { color: var(--color-ink); border-bottom-color: var(--color-hazard); }
  [data-lang-switch] { margin-inline-start: auto; }
  [data-lang-switch] a { color: var(--color-accent-magenta); text-transform: none; }
  [data-lang-switch] a:hover { color: var(--color-ink); }
  .short { display: none; }
  /* Phone: one compact row. The brand is dropped (the first link is the home
     section) and the language switch shortens to its code; its full name stays
     on the link as aria-label. */
  @media (max-width: 47.99rem) {
    .brand { display: none; }
    nav { padding-inline: 8px; }
    ul { gap: 0; }
    li a { padding-inline: 7px; font-size: 0.6875rem; letter-spacing: 0.02em; }
    .long { display: none; }
    .short { display: inline; }
    [data-lang-switch] a { text-transform: uppercase; }
  }
</style>
