---
/**
 * The always-present text navigation. Primary, not a fallback: it serves
 * keyboard, screen reader and crawler, and it is why a 3D layer can never
 * be the only way to reach the information.
 */
import { localizePath } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  current?: string;
}
const { lang, current } = Astro.props;
const t = useTranslations(lang);
// Section links carry the home path, not a bare hash: on the home page the
// browser still just scrolls, but from /blog/ a bare "#career" would point at
// a section that is not on the page and silently do nothing.
const home = localizePath('/', lang);
const items = [
  { id: 'career', href: `${home}#career`, label: t('nav.career') },
  { id: 'projects', href: `${home}#projects`, label: t('nav.projects') },
  { id: 'about', href: `${home}#about`, label: t('nav.about') },
  { id: 'blog', href: localizePath('/blog/', lang), label: t('nav.blog') },
  { id: 'contact', href: `${home}#contact`, label: t('nav.contact') },
];
---

<nav data-text-nav aria-label={t('nav.label')}>
  <ul>
    {items.map((i) => (
      <li><a href={i.href} aria-current={current === i.id ? 'page' : undefined}>{i.label}</a></li>
    ))}
  </ul>
</nav>

<style>
  nav { max-width: 48rem; margin: 0 auto 16px; }
  ul { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; margin: 0; padding: 0; }
  a {
    display: block;
    padding: 6px 10px;
    font-family: var(--font-pixel);
    font-size: 0.8125rem;
    text-transform: uppercase;
    color: var(--color-ink);
    text-decoration: none;
    background: var(--color-surface);
    border: 1px solid var(--color-bevel-dark);
    border-radius: 0;
    box-shadow: inset 1px 1px 0 var(--color-bevel-light), inset -1px -1px 0 var(--color-bevel-dark);
  }
  a:hover, a[aria-current] { color: var(--color-accent-cyan); }
  a:focus-visible { outline: 2px solid var(--color-accent-magenta); outline-offset: 2px; }
</style>
