---
/** The whole home page, shared by both locale routes so they cannot drift. */
import Base from '../layouts/Base.astro';
import Window from './Window.astro';
import DeskPoster from './DeskPoster.astro';
import TextNav from './TextNav.astro';
import ExperienceList from './ExperienceList.astro';
import ProjectList from './ProjectList.astro';
import AboutPanel from './AboutPanel.astro';
import SocialLinks from './SocialLinks.astro';
import SiteFooter from './SiteFooter.astro';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  description: string;
}
const { lang, description } = Astro.props;
const t = useTranslations(lang);
---

<Base title='Thiego "Zeru" Carvalho' description={description} lang={lang} path="/">
  <DeskPoster />
  <main>
    <Window title='Thiego "Zeru" Carvalho' id="top" tone="accent">
      <h1>{t('hero.role')}</h1>
      <p class="headline">{t('hero.headline')}</p>
      <p class="where">Osasco/SP — Brazil</p>
    </Window>
    <TextNav lang={lang} />
    <Window title={t('nav.career')} id="career"><ExperienceList lang={lang} /></Window>
    <Window title={t('nav.projects')} id="projects"><ProjectList lang={lang} /></Window>
    <Window title={t('nav.about')} id="about"><AboutPanel lang={lang} /></Window>
    <Window title={t('nav.contact')} id="contact" tone="accent">
      <p>{t('contact.intro')}</p>
      <p><a href="mailto:thiego@rocketmail.com">thiego@rocketmail.com</a></p>
      <SocialLinks />
    </Window>
  </main>
  <SiteFooter lang={lang} />
</Base>

<style>
  h1 { margin: 0 0 6px; font-family: var(--font-pixel); font-size: 1.125rem; font-weight: 400; color: var(--color-accent-cyan); }
  p { margin: 0 0 8px; }
  .headline { color: var(--color-ink-muted); }
  .where { margin: 0; font-size: 0.875rem; }
  a { color: var(--color-accent-cyan); }
</style>
