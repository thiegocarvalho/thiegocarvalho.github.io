---
/** The whole home page, shared by both locale routes so they cannot drift. */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Panel from './Panel.astro';
import Hero from './Hero.astro';
import TextNav from './TextNav.astro';
import FloppyCarousel from './FloppyCarousel.astro';
import SocialLinks from './SocialLinks.astro';
import SiteFooter from './SiteFooter.astro';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import plexBoldUrl from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-700-normal.woff2?url';
import plexBoldItalicUrl from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-700-italic.woff2?url';

interface Props {
  lang: Lang;
  description: string;
}
const { lang, description } = Astro.props;
const t = useTranslations(lang);
const projects = (await getCollection('projects')).length;
---

<Base title='Thiego "Zeru" Carvalho' description={description} lang={lang} path="/">
  <Fragment slot="head">
    <link rel="preload" href={plexBoldUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexBoldItalicUrl} as="font" type="font/woff2" crossorigin />
  </Fragment>
  <TextNav lang={lang} />
  <main>
    <Hero lang={lang} />
    <span class="hazard divider" aria-hidden="true"></span>
    <Panel title={t('nav.projects')} id="projects" index="01" label={`${projects} ${t('hud.disks')}`}>
      <FloppyCarousel lang={lang} />
    </Panel>
    <Panel title={t('nav.contact')} id="contact" index="02" label={t('hud.channel')}>
      <p class="intro">{t('contact.intro')}</p>
      <p class="mail"><a href="mailto:thiego@rocketmail.com">thiego@rocketmail.com</a></p>
      <SocialLinks />
    </Panel>
  </main>
  <SiteFooter lang={lang} />
</Base>

<style>
  .divider { margin: clamp(32px, 6vw, 64px) 0 clamp(56px, 9vw, 96px); }
  .intro { max-width: 40rem; margin: 0 0 16px; font-size: 1.25rem; }
  .mail { margin: 0 0 20px; font-size: clamp(1.25rem, 5vw, 2.25rem); font-weight: 700; font-style: italic; }
</style>
