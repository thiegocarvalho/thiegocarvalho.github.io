---
/** The whole home page, shared by both locale routes so they cannot drift. */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Panel from './Panel.astro';
import Hero from './Hero.astro';
import TextNav from './TextNav.astro';
import FloppyCarousel from './FloppyCarousel.astro';
import ContributionGraph from './ContributionGraph.astro';
import SiteFooter from './SiteFooter.astro';
import { localizePath, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';
import plexBoldUrl from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-700-normal.woff2?url';
import plexBoldItalicUrl from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-700-italic.woff2?url';

interface Props {
  lang: Lang;
  description: string;
}
const { lang, description } = Astro.props;
const t = useTranslations(lang);
const projects = (await getCollection('projects')).length;
// The three newest published posts of this locale, newest first. Drafts never reach the build.
const posts = (await getCollection('posts', (p) => !p.data.draft && p.id.split('/')[0] === lang))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
const fmt = new Intl.DateTimeFormat(lang === 'pt' ? 'pt-BR' : 'en-GB', { dateStyle: 'long', timeZone: 'UTC' });
---

<Base title='Thiego "Zeru" Carvalho' description={description} lang={lang} path="/">
  <Fragment slot="head">
    <link rel="preload" href={plexBoldUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexBoldItalicUrl} as="font" type="font/woff2" crossorigin />
  </Fragment>
  <TextNav lang={lang} />
  <main>
    <Hero lang={lang} />
    <span class="hazard divider" aria-hidden="true"></span>
    <Panel title={t('nav.blog')} id="blog" index="01">
      {
        posts.length === 0 ? (
          <p class="empty">{t('blog.empty')}</p>
        ) : (
          <>
            <ul class="posts">
              {posts.map((p) => (
                <li data-post>
                  <time datetime={p.data.pubDate.toISOString()}>{fmt.format(p.data.pubDate)}</time>
                  <a href={localizePath(`/blog/${p.id.split('/').slice(1).join('/')}/`, lang)}>{p.data.title}</a>
                  <p>{p.data.description}</p>
                </li>
              ))}
            </ul>
            <p class="all"><a href={localizePath('/blog/', lang)}>{t('blog.all')} →</a></p>
          </>
        )
      }
    </Panel>
    <Panel title={t('nav.projects')} id="projects" index="02" label={`${projects} ${t('hud.disks')}`}>
      <FloppyCarousel lang={lang} />
    </Panel>
    <ContributionGraph lang={lang} />
  </main>
  <SiteFooter lang={lang} />
</Base>

<style>
  /* the content column's width, like the footer stripe, not the window's */
  .divider { width: calc(100% - 32px); max-width: calc(72rem - 32px); margin: clamp(32px, 6vw, 64px) auto clamp(56px, 9vw, 96px); }
  .posts { display: grid; gap: 16px; margin: 0; padding: 0; list-style: none; }
  @media (min-width: 48rem) { .posts { grid-template-columns: repeat(3, 1fr); } }
  .posts li { display: flex; flex-direction: column; gap: 6px; padding: 16px; border: 1px solid var(--color-line); border-left: 3px solid var(--color-hazard); background: var(--color-surface); }
  .posts time { font-family: var(--font-pixel); font-size: 0.6875rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-ink-muted); }
  .posts li a { font-size: 1.25rem; font-weight: 700; font-style: italic; line-height: 1.2; text-decoration: none; }
  .posts li a:hover { text-decoration: underline; }
  .posts p { margin: 0; font-size: 0.9375rem; color: var(--color-ink-muted); }
  .all { margin: 16px 0 0; font-family: var(--font-pixel); font-size: 0.75rem; letter-spacing: 0.06em; text-transform: uppercase; }
  .empty { margin: 0; padding: 16px; border: 1px dashed var(--color-line-bright); color: var(--color-ink-muted); }
</style>
