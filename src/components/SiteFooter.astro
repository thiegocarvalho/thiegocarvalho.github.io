---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

const t = useTranslations(Astro.props.lang);
interface Props {
  lang: Lang;
}
---

<footer>
  <span class="hazard" aria-hidden="true"></span>
  <p>Thiego "Zeru" Carvalho · Osasco/SP — Brazil · {t('footer.rights')}</p>
</footer>

<style>
  footer { max-width: 72rem; margin: 0 auto; padding: 0 16px 24px; }
  p { margin: 12px 0 0; color: var(--color-ink-muted); font-family: var(--font-pixel); font-size: 0.6875rem; letter-spacing: 0.06em; }
</style>
