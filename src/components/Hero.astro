---
/**
 * Dossier-style hero. Every label is a fact already on the page: location,
 * stack, availability and the year the journey started all come from the
 * content and the about text.
 */
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// The highlighted word is a locale string ("Software" in both); the title is split around it.
const title = t('hero.title');
const word = t('hero.highlight');
const at = title.indexOf(word);
const before = title.slice(0, at);
const after = title.slice(at + word.length);
const focus = t('hero.headline').split(' · ');
---

<section data-hero id="top" aria-labelledby="hero-title">
  <p class="hud tl">FILE 001-ZERU // OSASCO/SP — BRAZIL</p>
  <p class="hud tr"><span class="dot" aria-hidden="true"></span>{t('hud.status')}</p>
  <p class="side" aria-hidden="true">{t('hud.side')}</p>

  <div class="main">
    <div class="id">
      <p class="name">Thiego <em>"Zeru"</em> Carvalho</p>
      <p class="headline">
        {focus.map((f) => <span>{f}</span>)}
      </p>
    </div>
    <div class="crt">
      <div class="rig">
        <span class="box foot" aria-hidden="true"><i class="fr"></i><i class="tp"></i><i class="sd"></i></span>
        <span class="box neck" aria-hidden="true"><i class="fr"></i><i class="sd"></i></span>
        <span class="box rear r1" aria-hidden="true"><i class="tp"></i><i class="sd"></i></span>
        <span class="box rear r2" aria-hidden="true"><i class="tp"></i><i class="sd"></i></span>
        <div class="case">
          <i class="tp" aria-hidden="true"></i><i class="sd" aria-hidden="true"></i>
          <div class="glass">
            <h1 id="hero-title">{before}<em data-text={word}>{word}</em>{after}</h1>
          </div>
          <div class="panel" aria-hidden="true">
            <span class="strip"></span>
            <span class="knob"></span>
            <span class="knob"></span>
            <span class="pled"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  [data-hero] {
    position: relative;
    box-sizing: border-box;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'tl tr'
      'main main';
    align-content: start;
    gap: 16px;
    max-width: 72rem;
    margin: 0 auto;
    padding: 24px 16px 0;
  }
  /* No forced screen height anywhere: the block hugs its content, so the
     name and monitor sit right under the HUD line instead of mid-screen. */
  @media (max-width: 47.99rem) {
    [data-hero] { gap: 10px 16px; padding-top: 12px; }
    .main { padding-block: 8px 12px; gap: 22px; }
  }
  .hud {
    margin: 0;
    font-family: var(--font-pixel);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    color: var(--color-ink-muted);
  }
  .tl { grid-area: tl; color: var(--color-accent-cyan); }
  .tr { grid-area: tr; color: var(--color-hazard); text-align: right; white-space: nowrap; }
  .dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 8px;
    background: var(--color-hazard);
    animation: blink 1.6s steps(2, jump-none) infinite;
  }
  @keyframes blink { 50% { opacity: 0.2; } }
  .side {
    display: none;
    position: absolute;
    right: -6px;
    top: 50%;
    margin: 0;
    font-family: var(--font-pixel);
    font-size: 0.6875rem;
    letter-spacing: 0.3em;
    color: var(--color-line-bright);
    writing-mode: vertical-rl;
    transform: translateY(-50%) rotate(180deg);
    white-space: nowrap;
  }
  @media (min-width: 80rem) { .side { display: block; } }
  /* Two columns from tablet up: the name (the big type now) on the left, the
     CRT carrying the title on the right. Stacked on phones: name, then monitor. */
  .main {
    grid-area: main;
    align-self: center;
    display: grid;
    gap: 28px;
    align-items: center;
    padding-block: 0 32px;
  }
  @media (min-width: 56rem) {
    .main { grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr); gap: 16px; }
  }
  /* each word of the name on its own line: the text runs and the accent
     become separate grid rows without any extra markup */
  .name {
    display: grid;
    margin: 0;
    font-weight: 700;
    font-size: clamp(2.75rem, 13vw, 7rem);
    line-height: 0.9;
    letter-spacing: -0.045em;
    text-transform: uppercase;
  }
  .name em { color: var(--color-hazard); font-style: italic; }
  @media (min-width: 56rem) { .name { font-size: clamp(2.75rem, 5.6vw, 4.75rem); } }

  /* ---- the monitor: same beige hardware as the project page's drive ---- */
  /*
   * Seen in three-quarter view, from above and to the right, turned toward the
   * name. Every part is a box of flat faces sharing one 3D space: a front, a
   * top and a right side are all the camera can see, so only those are drawn.
   * Depths are in cqw of .crt so the whole set scales with the column.
   */
  .crt {
    width: 100%;
    max-width: 52rem;
    justify-self: center;
    container-type: inline-size;
    padding-block: 3cqw 0;
  }
  .rig {
    position: relative;
    width: 72cqw;
    margin-left: 2cqw;
    margin-bottom: 7cqw;
    transform-style: preserve-3d;
    transform: perspective(2400px) rotateX(-18deg) rotateY(-38deg);
  }
  .box { position: absolute; display: block; transform-style: preserve-3d; }
  .box > i, .case > i { position: absolute; display: block; }
  .box > .fr { inset: 0; }
  /* the right side hinges back from the right edge, the top from the top edge */
  .sd {
    left: 100%;
    top: 0;
    width: var(--d);
    height: 100%;
    transform-origin: 0 50%;
    transform: rotateY(90deg);
  }
  .tp {
    left: 0;
    bottom: 100%;
    width: 100%;
    height: var(--d);
    transform-origin: 50% 100%;
    transform: rotateX(90deg);
  }
  /* light from the top left: tops brightest, right sides in shade, darker toward the back */
  .tp { background: linear-gradient(0deg, #ebe5d1, #d6cfb9); }
  .sd { background: linear-gradient(90deg, #a49e87, #7f7a66); }
  .fr { background: linear-gradient(#cfc8b2, #aca58f); }

  .case {
    --d: 12cqw;
    position: relative;
    box-sizing: border-box;
    width: 100%;
    padding: 6.5% 6.5% 4%;
    border-radius: 3px;
    transform-style: preserve-3d;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.35), transparent 10%),
      linear-gradient(180deg, #d4cdb8, #b3ac96);
    box-shadow: inset 0 -3px 0 rgb(0 0 0 / 0.25), inset 0 0 0 1px #8f8975;
  }
  /* the tube housing, stepping in twice toward the back, vents on its flank */
  .rear { left: 8%; top: 7%; width: 84%; height: 80%; --d: 26cqw; transform: translateZ(-12cqw); }
  .r2 { left: 21%; top: 16%; width: 58%; height: 58%; --d: 18cqw; transform: translateZ(-38cqw); }
  .rear > .sd {
    background:
      repeating-linear-gradient(180deg, transparent 0 7px, rgb(0 0 0 / 0.28) 7px 10px) 30% 30% / 50% 40% no-repeat,
      linear-gradient(90deg, #9a947d, #77725f);
  }
  /* swivel stand: a short neck under the housing and a wide foot */
  .neck { left: 36%; top: 100%; width: 28%; height: 4cqw; --d: 26cqw; transform: translateZ(-18cqw); }
  .foot { left: 18%; top: calc(100% + 4cqw); width: 64%; height: 3cqw; --d: 46cqw; transform: translateZ(-8cqw); }
  .foot > .fr { box-shadow: 0 16px 26px rgb(0 0 0 / 0.7); }
  .glass {
    position: relative;
    aspect-ratio: 4 / 3;
    container-type: inline-size;
    display: grid;
    align-content: center;
    overflow: hidden;
    padding: 6%;
    border-radius: 7% / 9%;
    background:
      radial-gradient(ellipse at 50% 45%, rgb(25 227 255 / 0.16), transparent 70%),
      #03080a;
    box-shadow:
      inset 0 0 0 2px #000,
      inset 0 0 38px 12px rgb(0 0 0 / 0.85),
      0 0 0 4px #8f8975,
      0 0 0 5px rgb(0 0 0 / 0.35),
      0 3px 0 5px rgb(255 255 255 / 0.3);
  }
  /* scanlines, curved-glass vignette and a soft glare, all over the text */
  .glass::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    border-radius: inherit;
    background:
      radial-gradient(ellipse 60% 40% at 24% 14%, rgb(255 255 255 / 0.1), transparent 70%),
      radial-gradient(ellipse at 50% 50%, transparent 55%, rgb(0 0 0 / 0.55) 100%),
      repeating-linear-gradient(180deg, rgb(0 0 0 / 0.28) 0 1px, transparent 1px 3px);
  }
  .panel {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
    height: 24px;
    margin-top: 12px;
  }
  .strip {
    flex: 1;
    height: 10px;
    border-radius: 2px;
    background: repeating-linear-gradient(90deg, #8c8670 0 2px, #a39d86 2px 5px);
    box-shadow: inset 0 1px 2px rgb(0 0 0 / 0.5), 0 1px 0 rgb(255 255 255 / 0.45);
  }
  .knob {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #d9d2bc, #8f8975);
    box-shadow: 0 1px 0 #4e4a3c, inset 0 0 0 1px rgb(0 0 0 / 0.2);
  }
  .pled {
    width: 12px;
    height: 6px;
    border-radius: 1px;
    background: #39ff7a;
    box-shadow: 0 0 8px 1px #39ff7a, inset 0 0 0 1px rgb(0 0 0 / 0.25);
  }

  /* The title on the glass. Sized from the screen's own width so it always
     fits the 4:3 tube; it is still the page's h1, real text, painted at once. */
  h1 {
    position: relative;
    margin: 0;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 16.5cqi;
    line-height: 0.9;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    text-wrap: balance;
    overflow-wrap: normal;
    text-shadow: 0 0 0.12em rgb(25 227 255 / 0.35);
  }
  h1:lang(pt) { font-size: 11.5cqi; }
  h1 em {
    position: relative;
    display: inline-block;
    font-style: italic;
    padding-right: 0.08em;
    color: var(--color-accent-cyan);
    text-shadow: 0.04em 0.04em 0 var(--color-accent-magenta);
  }
  /*
   * Glitch: two decorative copies of the word (generated content, empty
   * alt text so assistive tech never reads them) sit exactly over the real
   * text, invisible, and split apart in a short burst every few seconds. The
   * real word is untouched, painted normally, so LCP and layout are unaffected.
   */
  h1 em::before,
  h1 em::after {
    content: attr(data-text);
    content: attr(data-text) / '';
    position: absolute;
    inset: 0;
    padding-right: inherit;
    opacity: 0;
    pointer-events: none;
    text-shadow: none;
  }
  h1 em::before { color: var(--color-accent-magenta); }
  h1 em::after { color: #fff; mix-blend-mode: overlay; }
  @keyframes glitch-a {
    0%, 86%, 100% { opacity: 0; transform: none; clip-path: inset(0 0 0 0); }
    88% { opacity: 0.9; transform: translate(-0.045em, 0.01em); clip-path: inset(8% 0 62% 0); }
    90% { opacity: 0.9; transform: translate(0.05em, -0.01em); clip-path: inset(48% 0 24% 0); }
    92% { opacity: 0.9; transform: translate(-0.06em, 0); clip-path: inset(74% 0 4% 0); }
    94% { opacity: 0.9; transform: translate(0.03em, 0); clip-path: inset(22% 0 52% 0); }
    96% { opacity: 0; transform: none; clip-path: inset(0 0 0 0); }
  }
  @keyframes glitch-b {
    0%, 87%, 100% { opacity: 0; transform: none; clip-path: inset(0 0 0 0); }
    89% { opacity: 0.8; transform: translate(0.05em, 0); clip-path: inset(58% 0 12% 0); }
    91% { opacity: 0.8; transform: translate(-0.04em, 0.01em); clip-path: inset(14% 0 66% 0); }
    93% { opacity: 0.8; transform: translate(0.06em, 0); clip-path: inset(38% 0 38% 0); }
    95% { opacity: 0; transform: none; clip-path: inset(0 0 0 0); }
  }
  @keyframes glitch-shake {
    0%, 87%, 100% { transform: none; }
    89% { transform: translateX(0.012em) skewX(-4deg); }
    93% { transform: translateX(-0.012em); }
    95% { transform: none; }
  }
  @media (prefers-reduced-motion: no-preference) {
    h1 em {
      animation-name: glitch-shake;
      animation-duration: 3.6s;
      animation-timing-function: steps(1, end);
      animation-iteration-count: infinite;
    }
    h1 em::before {
      animation-name: glitch-a;
      animation-duration: 3.6s;
      animation-timing-function: steps(1, end);
      animation-iteration-count: infinite;
    }
    h1 em::after {
      animation-name: glitch-b;
      animation-duration: 3.6s;
      animation-timing-function: steps(1, end);
      animation-iteration-count: infinite;
    }
  }
  .headline {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 8px;
    max-width: 40rem;
    margin: 22px 0 0;
    padding: 0;
  }
  .headline span {
    padding: 4px 10px;
    font-size: 0.8125rem;
    line-height: 1.3;
    color: var(--color-ink);
    border: 1px solid var(--color-line-bright);
  }

  /*
   * Power-on, once, about 1.3s: the LED lights, a dot appears mid-tube,
   * stretches to a line, the line opens into a full white flash that decays
   * to the dark phosphor, and only then the title flickers in. Reduced motion
   * (and browsers without animations) see the lit screen and title at once.
   */
  @keyframes power-on {
    0% { opacity: 1; clip-path: inset(49.4% 49.4%); }
    14% { opacity: 1; clip-path: inset(49.4% 49.4%); }
    34% { opacity: 1; clip-path: inset(49.4% 0); }
    52% { opacity: 1; clip-path: inset(0); }
    100% { opacity: 0; clip-path: inset(0); }
  }
  @keyframes title-on {
    0% { opacity: 0; }
    30% { opacity: 1; }
    40% { opacity: 0.25; }
    55% { opacity: 1; }
    70% { opacity: 0.6; }
    100% { opacity: 1; }
  }
  @keyframes led-on { from { background: #1d3a26; box-shadow: none; } }
  /* the dead tube before the flash: flat dark glass, no phosphor glow */
  @keyframes tube-off { from { background: #0d100f; } }
  @media (prefers-reduced-motion: no-preference) {
    .glass {
      animation-name: tube-off;
      animation-duration: 0.55s;
      animation-timing-function: steps(1, end);
      animation-fill-mode: backwards;
    }
    .glass::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 2;
      pointer-events: none;
      background: radial-gradient(ellipse at center, #fff 0%, #eaffff 35%, rgb(25 227 255 / 0.6) 100%);
      animation-name: power-on;
      animation-duration: 0.75s;
      animation-delay: 0.2s;
      animation-timing-function: cubic-bezier(0.3, 0.6, 0.3, 1);
      animation-fill-mode: both;
    }
    .glass h1 {
      animation-name: title-on;
      animation-duration: 0.35s;
      animation-delay: 0.95s;
      animation-timing-function: steps(1, end);
      animation-fill-mode: backwards;
    }
    .pled {
      animation-name: led-on;
      animation-duration: 0.15s;
      animation-timing-function: steps(1, end);
      animation-fill-mode: backwards;
    }
  }

  /*
   * Scrolling out of the hero: the name slides off to the left and shrinks,
   * the monitor drifts right and dims, and the HUD labels fade. Tied to scroll
   * position only; unsupported browsers and reduced motion see the hero as is.
   */
  @keyframes hero-away {
    to { transform: translate3d(-14%, -6vh, 0) scale(0.7); opacity: 0; }
  }
  @keyframes crt-away {
    to { transform: translate3d(10%, -4vh, 0) scale(0.82); opacity: 0; filter: brightness(0.5); }
  }
  @keyframes hud-away {
    to { opacity: 0; }
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .id {
        transform-origin: 0 50%;
        animation-name: hero-away;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: exit 0% exit 85%;
      }
      .crt {
        transform-origin: 100% 50%;
        animation-name: crt-away;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: exit 0% exit 85%;
      }
      .hud, .side {
        animation-name: hud-away;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: exit 0% exit 60%;
      }
    }
  }
</style>
