---
/** Blog index for one locale, shared by both routes so they cannot drift. */
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Window from './Window.astro';
import TextNav from './TextNav.astro';
import SiteFooter from './SiteFooter.astro';
import { localizePath, useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const posts = (await getCollection('posts', (p) => !p.data.draft && p.id.split('/')[0] === lang)).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);
const fmt = new Intl.DateTimeFormat(lang === 'pt' ? 'pt-BR' : 'en-GB', { dateStyle: 'long', timeZone: 'UTC' });
const description = lang === 'pt' ? 'Textos sobre arquitetura, pagamentos e produto.' : 'Writing on architecture, payments and product.';
---

<Base title={`${t('nav.blog')} — Thiego "Zeru" Carvalho`} description={description} lang={lang} path="/blog/">
  <main>
    <Window title={t('nav.blog')} id="blog">
      <h1>{t('nav.blog')}</h1>
      {
        posts.length === 0 ? (
          <p>{t('blog.empty')}</p>
        ) : (
          <ul>
            {posts.map((p) => {
              const slug = p.id.split('/').slice(1).join('/');
              return (
                <li>
                  <a href={localizePath(`/blog/${slug}/`, lang)}>{p.data.title}</a>
                  <time datetime={p.data.pubDate.toISOString()}>{fmt.format(p.data.pubDate)}</time>
                  <p>{p.data.description}</p>
                </li>
              );
            })}
          </ul>
        )
      }
    </Window>
    <TextNav lang={lang} current="blog" />
  </main>
  <SiteFooter lang={lang} />
</Base>

<style>
  h1 { margin: 0 0 8px; font-family: var(--font-pixel); font-size: 1.125rem; font-weight: 400; color: var(--color-accent-cyan); }
  ul { list-style: none; margin: 0; padding: 0; }
  li { margin: 0 0 12px; }
  li p { margin: 2px 0 0; color: var(--color-ink-muted); }
  time { display: block; font-size: 0.875rem; color: var(--color-ink-muted); }
  a { color: var(--color-accent-cyan); }
</style>
