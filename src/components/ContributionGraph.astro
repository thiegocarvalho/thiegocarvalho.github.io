---
/**
 * The last year of GitHub contributions as a static grid: one column per
 * week, one cell per day, shaded by GitHub's own level. Built at deploy time
 * (see lib/contributions.ts), so it ships no script; renders nothing when the
 * data is unavailable.
 */
import Panel from './Panel.astro';
import { getContributions, GITHUB_LOGIN } from '../lib/contributions';
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const data = await getContributions();
const locale = lang === 'pt' ? 'pt-BR' : 'en-US';
const num = new Intl.NumberFormat(locale);
const day = new Intl.DateTimeFormat(locale, { dateStyle: 'medium', timeZone: 'UTC' });
const month = new Intl.DateTimeFormat(locale, { month: 'short', timeZone: 'UTC' });
const at = (d: string) => new Date(`${d}T00:00:00Z`);
// a month label over the first week column whose first day falls in a new month
const months = (data?.weeks ?? []).flatMap((w, i, all) => {
  const m = at(w[0].date).getUTCMonth();
  return i > 0 && m !== at(all[i - 1][0].date).getUTCMonth() ? [{ col: i + 1, name: month.format(at(w[0].date)) }] : [];
});
const firstRow = data ? at(data.weeks[0][0].date).getUTCDay() + 1 : 1;
---

{
  data && (
    <Panel title={t('activity.title')} id="activity" index="03" label={`${num.format(data.total)} ${t('activity.unit')}`}>
      <div class="scroll">
        <div class="cal" style={`--n:${data.weeks.length}`}>
          <p class="months" aria-hidden="true">
            {months.map((m) => <span style={`grid-column:${m.col}`}>{m.name}</span>)}
          </p>
          <p class="days" role="img" aria-label={`${num.format(data.total)} ${t('activity.summary')}`}>
            {data.weeks.flat().map((d, i) => (
              <i
                class={d.level ? `l${d.level}` : undefined}
                style={i === 0 && firstRow > 1 ? `grid-row-start:${firstRow}` : undefined}
                title={`${num.format(d.count)} · ${day.format(at(d.date))}`}
              />
            ))}
          </p>
        </div>
      </div>
      <p class="foot">
        <span>{num.format(data.private)} {t('activity.private')}</span>
        <span class="legend" aria-hidden="true">{t('activity.less')} <i /><i class="l1" /><i class="l2" /><i class="l3" /><i class="l4" /> {t('activity.more')}</span>
        <a href={`https://github.com/${GITHUB_LOGIN}`} rel="me">github.com/{GITHUB_LOGIN} →</a>
      </p>
    </Panel>
  )
}

<style>
  /* phones scroll the year sideways; rtl makes the scroll start at today */
  .scroll { overflow-x: auto; direction: rtl; }
  .cal { direction: ltr; min-width: 46rem; }
  .months, .days { display: grid; grid-template-columns: repeat(var(--n), 1fr); gap: 3px; margin: 0; }
  .months { margin-bottom: 6px; white-space: nowrap; font-family: var(--font-pixel); font-size: 0.625rem; text-transform: uppercase; color: var(--color-ink-muted); }
  .days { grid-template-rows: repeat(7, auto); grid-auto-flow: column; }
  .days i, .legend i { display: block; aspect-ratio: 1; background: var(--color-line); }
  .l1 { background: rgb(25 227 255 / 0.3) !important; }
  .l2 { background: rgb(25 227 255 / 0.6) !important; }
  .l3 { background: var(--color-accent-cyan) !important; }
  .l4 { background: var(--color-accent-magenta) !important; }
  .foot { display: flex; flex-wrap: wrap; gap: 8px 24px; justify-content: space-between; margin: 14px 0 0; font-family: var(--font-pixel); font-size: 0.6875rem; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-ink-muted); }
  .legend { display: flex; align-items: center; gap: 3px; }
  .legend i { width: 10px; }
</style>
