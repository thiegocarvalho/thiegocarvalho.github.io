---
import '../styles/global.css';
// Self-hosted fonts: a cross-origin Google Fonts stylesheet is render-blocking
// and its late font swap caused layout shift (measured in Lighthouse).
import '@fontsource/silkscreen/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-400.css';
import '@fontsource/ibm-plex-sans/latin-600.css';
import silkscreenUrl from '@fontsource/silkscreen/files/silkscreen-latin-400-normal.woff2?url';
import plexUrl from '@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url';
import { alternatesFor, htmlLang, localizePath } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  /** Locale-neutral path as served for English, e.g. "/" or "/blog/slug/". */
  path: string;
  /** Locales this page actually exists in. Defaults to both. */
  availableLangs?: Lang[];
}

const { title, description, lang, path, availableLangs = ['en', 'pt'] } = Astro.props;
const site = Astro.site!;
const abs = (p: string) => new URL(p, site).href;
const canonical = abs(localizePath(path, lang));
const alternates = alternatesFor(path, availableLangs);
---

<html lang={htmlLang(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={abs(a.href)} />)}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href={silkscreenUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexUrl} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <slot />
  </body>
</html>
