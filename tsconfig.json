{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/components/*"]
    },
    "types": ["astro/client", "vitest/globals"]
  },
  "include": [".astro/types.d.ts", "src/**/*", "tests/**/*", "*.config.mjs", "*.config.ts"],
  "exclude": ["dist"]
}
